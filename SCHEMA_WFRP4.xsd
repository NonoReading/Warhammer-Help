<?xml version="1.0" encoding="UTF-8"?>
<!--
  SCHEMA_WFRP4.xsd
  Strict validation schema for DATABASE/WFRP4/*.Xml.
  Generated from an audit of the corpus (31 books) plus a targeted manual review of the
  sensitive blocks (see GABARIT_LIVRE_XML.md). Policy: xs:sequence with the real order and
  obligation observed, no permissive xs:all / xs:any, except where noted below for blocks
  with a very variable internal structure (only one rich sample).

  Usage : xmllint (no-out flag) (schema flag) SCHEMA_WFRP4.xsd "DATABASE/WFRP4/BOOK_XXX.Xml"
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           elementFormDefault="qualified"
           attributeFormDefault="unqualified">

  <xs:include schemaLocation="SCHEMA_COMMON.xsd"/>

  <!-- ===================== WFRP4-only blocks ===================== -->

  <!--
    DATA_CAREER_ADAPTATION (1 sample, BOOK_HIGH_ELVES_IN_THE_OLD_WORLD.Xml or
    equivalent): the internal structure of the Level is very variable (Order, then a free choice among
    Talent{Remove}, Add, Trapping, Skill{Remove}, Standing...). Only one sample exists:
    the content of the Level is approximated permissively,
    to be revalidated / tightened if a future book diverges.
  -->
  <xs:complexType name="AdaptationLevelType">
    <xs:sequence>
      <xs:element name="Order" type="PlainString"/>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:element name="Talent" type="xs:anyType"/>
        <xs:element name="Skill" type="xs:anyType"/>
        <xs:element name="Add" type="PlainString"/>
        <xs:element name="Remove" type="PlainString"/>
        <xs:element name="Trapping" type="xs:anyType"/>
        <xs:element name="Standing" type="PlainString"/>
      </xs:choice>
    </xs:sequence>
    <xs:attribute name="id" type="xs:string" use="required"/>
  </xs:complexType>

  <xs:complexType name="AdaptationType">
    <xs:sequence>
      <xs:element name="Description" type="LangString"/>
      <xs:element name="Career" type="PlainString"/>
      <xs:element name="Specie" type="PlainString"/>
      <xs:element name="Optional" type="PlainString" minOccurs="0"/>
      <xs:element name="Standing" type="PlainString" minOccurs="0"/>
      <xs:element name="Level" type="AdaptationLevelType" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:attribute name="id" type="xs:string" use="required"/>
  </xs:complexType>

  <xs:complexType name="DataCareerAdaptationType">
      <xs:annotation>
        <xs:documentation xml:lang="en">SUBSTITUTIONS PER ETHNICITY in an existing career (e.g. High Elf Player's Guide p.60-62: an elf Pit Fighter replaces Dirty Fighting with Feint). One Adaptation = one career (Career, code from another book) x a list of ethnicities (Specie, codes separated by /). Optional=1: the book says "may choose" (the player may refuse); absent = imposed substitution. Each Level targets the career level by Order; it contains Talent/Skill/Trapping groups, each with &lt;Remove&gt; (what disappears) and &lt;Add&gt; (what replaces it). Example: &lt;Level id="1"&gt;&lt;Order&gt;"1"&lt;/Order&gt;&lt;Talent&gt;&lt;Remove&gt;"RULES-T0026"&lt;/Remove&gt;&lt;Add&gt;"RULES-T0055"&lt;/Add&gt;&lt;/Talent&gt;&lt;/Level&gt;. The inner elements are deliberately permissive (xs:anyType): only one book uses them.</xs:documentation>
      </xs:annotation>
    <xs:sequence>
      <xs:element name="Adaptation" type="AdaptationType" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <!-- DATA_CAREER_SUBCHOICE: repeated Choice, Career + Alternative[name]. -->
  <xs:complexType name="CareerSubchoiceType">
    <xs:sequence>
      <xs:element name="Career" type="PlainString"/>
      <xs:element name="Alternative" type="NamedString"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="DataCareerSubchoiceType">
      <xs:annotation>
        <xs:documentation xml:lang="en">SUB-ROLL: a rolled career is replaced by a variant according to a d100 roll. One Choice = Career (rolled career) + Alternative (name = career that replaces it, value = range "01-75"). For a trade with two outcomes, two Choices: one with the career itself as the alternative (01-75), one with the variant (76-100). The ranges of a same Career cover 01-100.</xs:documentation>
      </xs:annotation>
    <xs:sequence>
      <xs:element name="Choice" type="CareerSubchoiceType" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <!-- DATA_CLASS_ITEM: Class[name] containing a SUBCHAPTER_ITEM (additions) and, optionally,
       Remove (removes an item) / Replace[from] (replaces an item, optional quantity). -->
  <xs:complexType name="ClassItemType">
    <xs:sequence>
      <xs:element name="SUBCHAPTER_ITEM" type="SubchapterItem" minOccurs="0"/>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:element name="Remove" type="xs:string"/>
        <xs:element name="Replace" type="ClassItemReplaceType"/>
      </xs:choice>
    </xs:sequence>
    <xs:attribute name="name" type="xs:string" use="required"/>
  </xs:complexType>

  <xs:complexType name="ClassItemReplaceType">
    <xs:simpleContent>
      <xs:extension base="xs:string">
        <xs:attribute name="from" type="xs:string" use="required"/>
        <xs:attribute name="quantite" type="xs:string" use="optional"/>
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>

  <xs:complexType name="DataClassItemType">
      <xs:annotation>
        <xs:documentation xml:lang="en">STARTING EQUIPMENT PER social CLASS (Academic, Burgher, Courtier, Peasant, Ranger...), added to that of the career. Class name = class code (RULES-CLASS_xxx). SUBCHAPTER_ITEM: Item name = item code (RULES-TRAP_xxx) or free text ("Lunch"), value = level that grants it; repeating the line = several copies. Remove = item removed from the equipment; Replace from=old item, content = new item.</xs:documentation>
      </xs:annotation>
    <xs:sequence>
      <xs:element name="Class" type="ClassItemType" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <!--
    DATA_SPECIE_TRAIT (1 sample): SpecieTrait[id] > Description + repeated Option[id]*,
    each Option has its own Description + Talent(s). Structure approximated as a permissive
    xs:choice for the content of each Option (variable Talent list), to be revalidated if
    a future book diverges.
  -->
  <xs:complexType name="SpecieTraitOptionType">
    <xs:sequence>
      <xs:element name="Description" type="LangString"/>
      <xs:element name="Talent" type="PlainString" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:attribute name="id" type="xs:string" use="required"/>
  </xs:complexType>

  <xs:complexType name="SpecieTraitType">
    <xs:sequence>
      <xs:element name="Description" type="LangString"/>
      <xs:element name="Option" type="SpecieTraitOptionType" maxOccurs="unbounded"/>
          <!-- Page of the source book that gives the sheet. Free text: "38", "45-46". -->
      <xs:element name="Page" type="PlainString" minOccurs="0"/>
    </xs:sequence>
    <xs:attribute name="id" type="xs:string" use="required"/>
  </xs:complexType>

  <xs:complexType name="DataSpecieTraitType">
      <xs:annotation>
        <xs:documentation xml:lang="en">CHOICE AMONG N GROUPS OF TALENTS given to an ethnicity (the "Trait (Any)" of Nations of Mankind: Provincial Trait, City State Trait...). A BOOK block cited from the SUBCHAPTER_TALENT of an ethnicity, because one list serves several ethnicities. SpecieTrait = the trait (Description = label faithful to the book); each Option = one outcome (Description + ONE Talent tag containing a comma-separated list, where each element can be "A/B" for a choice and RULES-T* for a randomly drawn talent). Example: &lt;Talent&gt;"RULES-T0085/RULES-T0119,RULES-T*"&lt;/Talent&gt; = Old Salt or Sea Legs, plus a random talent.</xs:documentation>
      </xs:annotation>
    <xs:sequence>
      <xs:element name="SpecieTrait" type="SpecieTraitType" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <!-- DATA_CAREER_SPECIE: repeated Entry, no id on the wrapper. -->
  <xs:complexType name="CareerSpecieEntryType">
    <xs:sequence>
      <xs:element name="Specie" type="PlainString"/>
      <xs:element name="Career" type="NamedString"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="DataCareerSpecieType">
      <xs:annotation>
        <xs:documentation xml:lang="en">ACCESS OF A RACE TO CAREERS of an added book. One Entry = Specie (a RACE: all its ethnicities inherit it) + Career name, value "X" = career that is eligible but outside the d100 roll (the player can choose it, chance does not give it). Used when a supplement adds careers to a Rulebook race without redeclaring the race; without this, a player who does not own the book would still see them.</xs:documentation>
      </xs:annotation>
    <xs:sequence>
      <xs:element name="Entry" type="CareerSpecieEntryType" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <!-- DATA_SPECIE_CAREER_CHOICE: Choice > Specie, Career, Alternative. -->
  <xs:complexType name="SpecieCareerChoiceType">
    <xs:sequence>
      <xs:element name="Specie" type="PlainString"/>
      <xs:element name="Career" type="PlainString"/>
      <xs:element name="Alternative" type="PlainString"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="DataSpecieCareerChoiceType">
      <xs:annotation>
        <xs:documentation xml:lang="en">REPLACEMENT OF A CAREER FOR A RACE: when the roll gives Career for the race Specie, the career Alternative (from an added book) is offered / taken in its place. One Choice = Specie + Career + Alternative, three codes. No id.</xs:documentation>
      </xs:annotation>
    <xs:sequence>
      <xs:element name="Choice" type="SpecieCareerChoiceType" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <!-- DATA_STARSIGN (1 sample): rich but stable structure, kept strict. -->
  <xs:complexType name="StarSignType">
    <xs:sequence>
      <xs:element name="Range" type="PlainString"/>
      <xs:element name="Description" type="LangString"/>
      <xs:element name="Title" type="LangString"/>
      <xs:element name="Classical" type="PlainString"/>
      <xs:element name="Ascendant" type="PlainString"/>
      <xs:element name="Dates" type="PlainString"/>
      <xs:element name="God" type="PlainString"/>
      <xs:element name="Appearance" type="LangString"/>
      <xs:element name="Personality" type="LangString"/>
      <xs:element name="Variant" type="StarSignVariantType" minOccurs="0" maxOccurs="unbounded"/>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:element name="Modifier" type="NamedString"/>
        <xs:element name="Talent" type="PlainString"/>
      </xs:choice>
          <!-- Page of the source book that gives the sheet. Free text: "38", "45-46". -->
      <xs:element name="Page" type="PlainString" minOccurs="0"/>
    </xs:sequence>
    <xs:attribute name="id" type="xs:string" use="required"/>
  </xs:complexType>

  <!-- <Variant range="1-3"><Talent>...</Talent><Modifier name="...">...</Modifier></Variant> -->
  <xs:complexType name="StarSignVariantType">
    <xs:sequence>
      <xs:element name="Talent" type="PlainString" minOccurs="0"/>
      <xs:element name="Modifier" type="NamedString" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:attribute name="range" type="xs:string" use="required"/>
  </xs:complexType>

  <xs:complexType name="DataStarsignType">
    <xs:annotation>
      <xs:documentation xml:lang="en">STAR SIGNS (optional rule STARSIGN): one StarSign per sign. Range (d100 range that designates it), Description, Title, Classical, Ascendant, Dates, God, Appearance, Personality are mandatory; effects: Modifier name=RULES-ATTR_xx (signed value) and/or Talent. Variant range=... (range "1-3" or a single digit "10"): d10 sub-roll of a sign with variants (Witchling Star), each variant has its Talent / Modifier. Order: the nine descriptions, the Variants, the Modifier / Talent, Page. Modifier is in quotation marks (unlike the ModifyCarac).</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="StarSign" type="StarSignType" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <!-- DATA_AFFLICTION (1 sample, BOOK UNOFFICIAL GRIMOIRE.Xml, 12 entries):
       Affliction[name] > Description, Explanation, then at most ONE of the two tags
       ModifyCaracAleatoire[name] / ModifySkillAttribut[name] as an option (never both
       together in the sample). -->
  <xs:complexType name="AfflictionEntryType">
    <xs:sequence>
      <xs:element name="Description" type="LangString"/>
      <xs:element name="Explanation" type="LangString"/>
      <xs:group ref="ModificateursEffets" minOccurs="0"/>
          <!-- Page of the source book. -->
      <xs:element name="Page" type="PlainString" minOccurs="0"/>
    </xs:sequence>
    <xs:attribute name="name" type="xs:string" use="required"/>
  </xs:complexType>

  <xs:complexType name="DataAfflictionType">
    <xs:annotation>
      <xs:documentation xml:lang="en">AFFLICTIONS (Pathology tab): one Affliction per entry, name = code (BOOK-AFFLICT_NAME, stored on the character: never rename it). Description, Explanation, optional numeric effects (ModifyCarac, ModifyCaracAleatoire...). No chance table: the d100 ranges per caster stay as text in Explanation.</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="Affliction" type="AfflictionEntryType" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <!-- DATA_DISEASE: Disease[name], no id (confirmed on BOOK_RULESBOOK.Xml). -->
  <xs:complexType name="DiseaseType">
    <xs:sequence>
      <xs:element name="Description" type="LangString"/>
      <xs:element name="Contraction" type="LangString"/>
      <xs:element name="Incubation" type="LangString"/>
      <xs:element name="Duration" type="LangString"/>
      <xs:element name="Symptoms" type="LangString" minOccurs="0"/>
      <!-- Permanent numeric modifiers (SourceModifMaladie). -->
      <xs:group ref="ModificateursEffets" minOccurs="0" maxOccurs="unbounded"/>
          <!-- Page of the source book. -->
      <xs:element name="Page" type="PlainString" minOccurs="0"/>
    </xs:sequence>
    <xs:attribute name="name" type="xs:string" use="required"/>
  </xs:complexType>

  <xs:complexType name="DataDiseaseType">
    <xs:annotation>
      <xs:documentation xml:lang="en">DISEASES (Pathology tab): one Disease per disease, name = code (BOOK-DISEASE_NAME, stored on the character). Description, Contraction, Incubation, Duration (text of the book, translatable), optional Symptoms, optional permanent numeric effects. No chance table.</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="Disease" type="DiseaseType" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <!-- DATA_OPTION_RULE -->
  <xs:complexType name="OptionRuleType">
    <xs:sequence>
      <xs:element name="Code" type="PlainString"/>
      <xs:element name="Description" type="LangString"/>
      <xs:element name="Explanation" type="LangString"/>
          <!-- Page of the source book. -->
      <xs:element name="Page" type="PlainString" minOccurs="0"/>
    </xs:sequence>
    <xs:attribute name="id" type="xs:string" use="required"/>
  </xs:complexType>

  <xs:complexType name="DataOptionRuleType">
    <xs:annotation>
      <xs:documentation xml:lang="en">OPTIONAL RULES WIRED TO THE ENGINE: one OptionRule per switch. Code = QUICKARMOUR, STARSIGN or CAREERALT (the only three known to the engine; any other code has no effect). Description / Explanation are shown to the player in the options window (INI per book; checkbox of the Book step for STARSIGN and CAREERALT).</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="OptionRule" type="OptionRuleType" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <!-- ===================== DATA_BOOK (root) ===================== -->
  <!--
    DISCLAIMER: minOccurs="0" because 2/31 WFRP4 books lack one (known debt,
    documented in GABARIT_LIVRE_XML.md). TO BE SET BACK to minOccurs="1" once this debt
    is cleared.
    Content: any combination of the listed DATA_* blocks, 0 or more times
    each (xs:choice maxOccurs="unbounded"), as observed in the real corpus (each
    book has only a subset, in any order).
  -->
  <xs:element name="DATA_BOOK">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="CODE_BOOK" type="PlainString"/>
        <xs:element name="BOOK" type="PlainString"/>
        <xs:element name="BOOKNAME" type="PlainString" minOccurs="0"/>
        <xs:element name="language" type="PlainString"/>
        <xs:element name="VERSION" type="PlainString"/>
        <xs:element name="OFFICIAL" type="PlainString"/>
        <xs:element name="COMPLETE" type="PlainString"/>
        <xs:element name="REVISION" type="PlainString" minOccurs="0"/>
        <xs:element name="REVISION_LABEL" type="PlainString" minOccurs="0"/>
        <xs:element name="DISCLAIMER" type="PlainString" minOccurs="0"/>
        <xs:choice minOccurs="0" maxOccurs="unbounded">
          <xs:element name="DATA_LABEL" type="DataLabelType"/>
          <xs:element name="DATA_TALENT" type="DataTalentType"/>
          <xs:element name="DATA_TALENT_SPECIALIZATION" type="DataTalentSpecializationType"/>
          <xs:element name="DATA_SPELL" type="DataSpellType"/>
          <xs:element name="DATA_SPELL_TALENT" type="DataSpellTalentType"/>
          <xs:element name="DATA_CONDITION" type="DataConditionType"/>
          <xs:element name="DATA_CAREER" type="DataCareerType"/>
          <xs:element name="DATA_CAREER_ADAPTATION" type="DataCareerAdaptationType"/>
          <xs:element name="DATA_CAREER_BONUS" type="DataCareerBonusType"/>
          <xs:element name="DATA_CAREER_ROLL" type="DataCareerRollType"/>
          <xs:element name="DATA_CAREER_SUBCHOICE" type="DataCareerSubchoiceType"/>
          <xs:element name="DATA_CLASS_ITEM" type="DataClassItemType"/>
          <xs:element name="DATA_ARMOR" type="DataArmorType"/>
          <xs:element name="DATA_ARMOR_SIMP" type="DataArmorSimpType"/>
          <xs:element name="DATA_ARMOR_BONUS" type="DataArmorBonusType"/>
          <xs:element name="DATA_WEAPON" type="DataWeaponType"/>
          <xs:element name="DATA_WEAPON_BONUS" type="DataWeaponBonusType"/>
          <xs:element name="DATA_CRAFTMANSHIP" type="DataCraftmanshipType"/>
          <xs:element name="DATA_SKILL" type="DataSkillType"/>
          <xs:element name="DATA_SKILL_SPECIALIZATION" type="DataSkillSpecializationType"/>
          <xs:element name="DATA_SKILL_COST" type="DataCostType"/>
          <xs:element name="DATA_ATTRIBUT_COST" type="DataCostType"/>
          <xs:element name="DATA_ATTRIBUT" type="DataAttributType"/>
          <xs:element name="DATA_SPECIE" type="DataSpecieType"/>
          <xs:element name="DATA_RACE" type="DataRaceType"/>
          <xs:element name="DATA_SPECIE_TRAIT" type="DataSpecieTraitType"/>
          <xs:element name="DATA_CAREER_SPECIE" type="DataCareerSpecieType"/>
          <xs:element name="DATA_SPECIE_CAREER_CHOICE" type="DataSpecieCareerChoiceType"/>
          <xs:element name="DATA_RANDOM_SPECIE" type="DataRandomSpecieType"/>
          <xs:element name="DATA_RANDOM_TALENT" type="DataRandomTalentType"/>
          <xs:element name="DATA_NATION" type="DataNationType"/>
          <xs:element name="DATA_OPTION_RULE" type="DataOptionRuleType"/>
          <xs:element name="DATA_RULE" type="DataRuleType"/>
          <xs:element name="DATA_RULE_SPECIE" type="DataRuleSpecieType"/>
          <xs:element name="DATA_RULE_BACKGROUND" type="DataRuleBackgroundType"/>
          <xs:element name="DATA_RULE_BACKGROUND_COUNT" type="DataRuleBackgroundCountType"/>
          <xs:element name="DATA_RULE_SKILL_ROLL" type="DataRuleSkillRollType"/>
          <xs:element name="DATA_RULE_TALENT_ROLL" type="DataRuleTalentRollType"/>
          <xs:element name="DATA_TRAPPING" type="DataTrappingType"/>
          <xs:element name="DATA_STARSIGN" type="DataStarsignType"/>
          <xs:element name="DATA_AFFLICTION" type="DataAfflictionType"/>
          <xs:element name="DATA_DISEASE" type="DataDiseaseType"/>
          <xs:element name="DATA_CORRUPTION_MENTAL" type="DataCorruptionMentalType"/>
          <xs:element name="DATA_CORRUPTION_PHYSICAL" type="DataCorruptionPhysicalType"/>
          <xs:element name="DATA_CORRUPTION_MENTAL_CHANCE" type="DataCorruptionMentalChanceType"/>
          <xs:element name="DATA_CORRUPTION_PHYSICAL_CHANCE" type="DataCorruptionPhysicalChanceType"/>
          <xs:element name="DATA_CORRUPTION_TABLE_MENTAL" type="DataCorruptionTableMentalType"/>
          <xs:element name="DATA_CORRUPTION_TABLE_PHYSICAL" type="DataCorruptionTablePhysicalType"/>
        </xs:choice>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

</xs:schema>
