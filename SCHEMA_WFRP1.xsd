<?xml version="1.0" encoding="UTF-8"?>
<!--
  SCHEMA_WFRP1.xsd
  Schema of DATABASE/WFRP1/*.Xml (WFRP 1st edition). Like SCHEMA_WFRP2.xsd it INCLUDES SCHEMA_COMMON.xsd:
  characteristics, races, ethnicities, rolls and personal-detail tables keep the common blocks; only
  the V1-specific additions remain here (career with Advance Scheme, skill with an effect,
  spell with magic points, deity, magical handicap, equipment with availability).
  V1 has no talents and no secondary profile. Combat, poisons, diseases and criticals stay as rule text (DATA_RULE).
  Codes: BOOK-TYPE_NAME (RULES-WORK_..., RULES-COMP_..., RULES-SPELL_...).
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           elementFormDefault="qualified"
           attributeFormDefault="unqualified">

  <xs:include schemaLocation="SCHEMA_COMMON.xsd"/>

  <!-- ===================== CAREER V1 ===================== -->
  <xs:complexType name="AdvanceSchemeType">
    <xs:annotation>
      <xs:documentation xml:lang="en">ADVANCE SCHEME: one line per profile column whose ceiling is non-zero. name = characteristic (RULES-ATTR_*), value = cumulative CEILING as in the book (10 = +10 %, 1 = +1 for M / S / T / A, 2 = +2 Wounds). This is not a gain: the character can buy advances up to this ceiling (100 XP per advance).</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="Advance" maxOccurs="unbounded">
        <xs:complexType>
          <xs:simpleContent>
            <xs:extension base="xs:string">
              <xs:attribute name="name" type="xs:string" use="required"/>
            </xs:extension>
          </xs:simpleContent>
        </xs:complexType>
      </xs:element>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="CareerV1Type">
    <xs:sequence>
      <xs:element name="Description" type="LangString"/>
      <xs:element name="Explanation" type="LangString" minOccurs="0"/>
      <!-- Warrior / Ranger / Rogue / Academic: class of origin of the basic career; used for the cost of changing career (100 XP same class, 200 XP other class). -->
      <!-- Absent for an advanced career (the class only exists at creation). -->
      <xs:element name="Class" type="xs:string" minOccurs="0"/>
      <!-- "1" for a basic career (rolled at creation), absent for an advanced one. -->
      <xs:element name="Basic" type="xs:string" minOccurs="0"/>
      <!-- Level 1 to 4 of the magic and priest careers (Wizard, Alchemist, Cleric, Druidic Priest...); "0" for an apprentice; absent otherwise. -->
      <xs:element name="Level" type="xs:string" minOccurs="0"/>
      <!-- Linked school of magic or cult: Wizard, Alchemist, Demonologist, Elementalist, Illusionist, Necromancer, Cleric, Druidic Priest. -->
      <xs:element name="MagicSchool" type="xs:string" minOccurs="0"/>
      <!-- XP cost to enter the career (100 / 200 / 300 / 400 for magic, 800 for a level 4 specialist...). Absent: normal cost of the rules. -->
      <xs:element name="EntryCost" type="xs:string" minOccurs="0"/>
      <xs:element name="AdvanceScheme" type="AdvanceSchemeType"/>
      <!-- Text of the book, "A or B" kept; list as codes in SUBCHAPTER_SKILL. -->
      <xs:element name="Skills" type="xs:string" minOccurs="0"/>
      <xs:element name="SUBCHAPTER_SKILL" type="SubchapterSkill" minOccurs="0"/>
      <xs:element name="Trappings" type="xs:string"/>
      <xs:element name="SUBCHAPTER_ITEM" type="SubchapterItem" minOccurs="0"/>
      <xs:element name="StartMoney" type="xs:string" minOccurs="0"/>
      <!-- No entries or exits in the career: the links between careers are in DATA_CAREER_LINK_V1. -->
      <!-- Source book of a career reprinted elsewhere. -->
      <xs:element name="Source" type="xs:string" minOccurs="0"/>
      <xs:element name="Page" type="xs:string" minOccurs="0"/>
    </xs:sequence>
    <xs:attribute name="id" type="xs:string" use="required"/>
  </xs:complexType>

  <xs:complexType name="DataCareerV1Type">
    <xs:sequence>
      <xs:element name="Career" type="CareerV1Type" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <!-- ===================== LINKS BETWEEN V1 CAREERS ===================== -->
  <xs:complexType name="CareerLinkV1Type">
    <xs:annotation>
      <xs:documentation xml:lang="en">"CAREER 1 > CAREER 2" LINK: one can move from the career name (code) to the career whose code is the value. The entries of a career are the links that arrive at it, its exits the links that leave it: neither is stored in the career. A book adds its links here, including to or from a career of another book (a supplement adds a career without being able to modify those of the Rulebook). A link is stored in the book that brings the most recent career.</xs:documentation>
    </xs:annotation>
    <xs:simpleContent>
      <xs:extension base="xs:string">
        <xs:attribute name="name" type="xs:string" use="required"/>
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>

  <xs:complexType name="DataCareerLinkV1Type">
    <xs:sequence>
      <xs:element name="Link" type="CareerLinkV1Type" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <!-- ===================== SKILL V1 ===================== -->
  <xs:complexType name="SkillBonusType">
    <xs:annotation>
      <xs:documentation xml:lang="en">NUMERIC EFFECT of a skill, applied automatically. Kind = TEST (percentage bonus to a named test: Target = test, Value = +10), CHARACTERISTIC (Target = RULES-ATTR_*, Value = +1 or +10, Very Strong S +1, Fleet Footed M +1), or another free-text value that is not applied.</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="Kind" type="xs:string"/>
      <xs:element name="Target" type="xs:string"/>
      <xs:element name="Value" type="xs:string"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="SkillV1Type">
    <xs:sequence>
      <xs:element name="Description" type="LangString"/>
      <!-- Effect as in the book. -->
      <xs:element name="Explanation" type="LangString"/>
      <xs:element name="Bonus" type="SkillBonusType" minOccurs="0" maxOccurs="unbounded"/>
      <!-- "oui": cumulative through multiple acquisition (Pick Lock, Pick Pocket); absent otherwise. -->
      <xs:element name="Cumulative" type="xs:string" minOccurs="0"/>
      <!-- "1" if the skill is a family with variants (Specialist Weapon, Secret Language, Arcane Language, Musicianship): the variants are DATA_SKILL_SPECIALIZATION of code COMP_FAMILY__VARIANT. -->
      <xs:element name="Variants" type="xs:string" minOccurs="0"/>
      <xs:element name="Page" type="xs:string" minOccurs="0"/>
    </xs:sequence>
    <xs:attribute name="id" type="xs:string" use="required"/>
  </xs:complexType>

  <xs:complexType name="DataSkillV1Type">
    <xs:sequence>
      <xs:element name="Skill" type="SkillV1Type" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <!-- ===================== SPELL V1 ===================== -->
  <xs:complexType name="SpellV1Type">
    <xs:sequence>
      <xs:element name="Description" type="LangString"/>
      <xs:element name="Explanation" type="LangString"/>
      <!-- Spell list: Petty, Battle, Demonic, Elemental, Illusion, Necromantic, Druidic, or Clerical (spells reserved to a cult, named in the effect), or Divine (prayers of Realm of Divine Magic). -->
      <xs:element name="SpellList" type="xs:string"/>
      <!-- P, 1, 2, 3 or 4. -->
      <xs:element name="SpellLevel" type="xs:string"/>
      <!-- Magic points: a number, or text if variable ("1 per Fire Ball"). -->
      <xs:element name="MagicPoints" type="xs:string"/>
      <xs:element name="Range" type="xs:string"/>
      <xs:element name="Duration" type="xs:string"/>
      <xs:element name="Ingredients" type="xs:string" minOccurs="0"/>
      <!-- Prayers (Realm of Divine Magic): area of effect and resistance (None, WP...). Absent for spells. -->
      <xs:element name="AreaOfEffect" type="xs:string" minOccurs="0"/>
      <xs:element name="Resistance" type="xs:string" minOccurs="0"/>
      <!-- "oui" if the target is entitled to a Magic test (Willpower), "non" for a magic missile; absent: not specified. -->
      <xs:element name="MagicTest" type="xs:string" minOccurs="0"/>
      <xs:element name="Page" type="xs:string" minOccurs="0"/>
    </xs:sequence>
    <xs:attribute name="id" type="xs:string" use="required"/>
  </xs:complexType>

  <xs:complexType name="DataSpellV1Type">
    <xs:sequence>
      <xs:element name="SpellV1" type="SpellV1Type" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <!-- ===================== DEITY V1 ===================== -->
  <xs:complexType name="SpellAccessType">
    <xs:annotation>
      <xs:documentation xml:lang="en">SPELL ACCESS RULE of a cult (no spell list of its own for each god): Kind = LIST (Value = a whole list, e.g. "Petty", "Battle"), SPELL (Value = code of a specific spell), LEVELS (list limited to levels, e.g. "Elemental 1-2"), EXCLUDE (forbidden spell or list), ONE_PER_LEVEL (a single spell per level drawn from this list, druids), NOTE (spell cited by the book but not found in the lists entered, to be checked). Note = particular condition as text.</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="Kind" type="xs:string"/>
      <xs:element name="Value" type="xs:string"/>
      <xs:element name="Note" type="xs:string" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="SkillAccessType">
    <xs:annotation>
      <xs:documentation xml:lang="en">SKILLS OF THE CULT, in addition to those of the Initiate and Cleric careers (bought for 100 XP, except INITIATE and CLERIC_FREE). Kind = INITIATE (gained free at the Initiate level), CLERIC_FREE (free on becoming a Cleric), CHOICE (one skill of your choice per level, Initiate and Cleric, among all those of this Kind of the cult), FAMILY (one skill of your choice from a whole family: Value = LANGUAGE, LORE, IDENTIFY), RANGER_CHART (100 XP = one roll on the Ranger skill table, at the Initiate level and at each Cleric level), DOUBLE_EFFECT (the skill was already taken: the effect is doubled, single purchase), OPTION (particular purchase described in Note). Value = skill code. Note = clarification as text.</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="Kind" type="xs:string"/>
      <xs:element name="Value" type="xs:string"/>
      <xs:element name="Note" type="xs:string" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="DeityV1Type">
    <xs:sequence>
      <xs:element name="Description" type="LangString"/>
      <xs:element name="Explanation" type="LangString" minOccurs="0"/>
      <xs:element name="Alignment" type="xs:string"/>
      <xs:element name="Domain" type="xs:string" minOccurs="0"/>
      <xs:element name="Strictures" type="xs:string" minOccurs="0"/>
      <xs:element name="SpellAccess" type="SpellAccessType" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="SkillAccess" type="SkillAccessType" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="Trials" type="xs:string" minOccurs="0"/>
      <xs:element name="Blessings" type="xs:string" minOccurs="0"/>
      <xs:element name="Temples" type="xs:string" minOccurs="0"/>
      <xs:element name="FriendsEnemies" type="xs:string" minOccurs="0"/>
      <xs:element name="Page" type="xs:string" minOccurs="0"/>
    </xs:sequence>
    <xs:attribute name="id" type="xs:string" use="required"/>
  </xs:complexType>

  <xs:complexType name="DataDeityV1Type">
    <xs:sequence>
      <xs:element name="Deity" type="DeityV1Type" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <!-- ===================== CULT V1 (Realm of Divine Magic) ===================== -->
  <xs:complexType name="CultPrayerType">
    <xs:annotation>
      <xs:documentation xml:lang="en">PRAYER OF A CULT per rank. Rank = INITIATE, 1, 2, 3 or 4. Kind = REQUIRED (must be granted before the next rank) or HONOR (may be granted, not required). Value = id of a prayer (Divine list).</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="Rank" type="xs:string"/>
      <xs:element name="Kind" type="xs:string"/>
      <xs:element name="Value" type="xs:string"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="CultGiftType">
    <xs:annotation>
      <xs:documentation xml:lang="en">GIFT of a cult (Gifts). Rank = 1 to 4, TEMPLAR, DEMAGOGUE (or another career of the cult). Text = effect as text.</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="Rank" type="xs:string"/>
      <xs:element name="Text" type="LangString"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="CultV1Type">
    <xs:annotation>
      <xs:documentation xml:lang="en">CULT of the book Realm of Divine Magic: prayer lists per rank and gifts. Deity = id of the deity of the base book (RULES-DEITY_*).</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="Description" type="LangString"/>
      <xs:element name="Deity" type="xs:string" minOccurs="0"/>
      <xs:element name="Prayer" type="CultPrayerType" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="Gift" type="CultGiftType" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="Page" type="xs:string" minOccurs="0"/>
    </xs:sequence>
    <xs:attribute name="id" type="xs:string" use="required"/>
  </xs:complexType>

  <xs:complexType name="DataCultV1Type">
    <xs:sequence>
      <xs:element name="Cult" type="CultV1Type" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <!-- ===================== MAGICAL HANDICAP V1 ===================== -->
  <xs:complexType name="DisabilityStageType">
    <xs:annotation>
      <xs:documentation xml:lang="en">STAGE of a handicap (1 to 3, cumulative unless stated). Modifier name = characteristic (RULES-ATTR_*), signed value (-5, -10, -1) applied automatically; one line per column affected. Text = non-numeric effect.</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="Modifier" minOccurs="0" maxOccurs="unbounded">
        <xs:complexType>
          <xs:simpleContent>
            <xs:extension base="xs:string">
              <xs:attribute name="name" type="xs:string" use="required"/>
            </xs:extension>
          </xs:simpleContent>
        </xs:complexType>
      </xs:element>
      <xs:element name="Text" type="LangString" minOccurs="0"/>
    </xs:sequence>
    <xs:attribute name="number" type="xs:string" use="required"/>
  </xs:complexType>

  <xs:complexType name="DisabilityV1Type">
    <xs:sequence>
      <xs:element name="Description" type="LangString"/>
      <xs:element name="Explanation" type="LangString"/>
      <!-- Three stages at most; a handicap without a stage (Strength Loss, Insanity) has none and carries its effect in Permanent. -->
      <xs:element name="Stage" type="DisabilityStageType" minOccurs="0" maxOccurs="3"/>
      <!-- Permanent loss (Strength Loss: S -1; Toughness Loss: T -1; Wound Loss: W -1), same form as Modifier. -->
      <xs:element name="Permanent" minOccurs="0" maxOccurs="unbounded">
        <xs:complexType>
          <xs:simpleContent>
            <xs:extension base="xs:string">
              <xs:attribute name="name" type="xs:string" use="required"/>
            </xs:extension>
          </xs:simpleContent>
        </xs:complexType>
      </xs:element>
      <!-- Insanity points gained immediately (Insanity: D6). -->
      <xs:element name="InsanityPoints" type="xs:string" minOccurs="0"/>
      <xs:element name="Page" type="xs:string" minOccurs="0"/>
    </xs:sequence>
    <xs:attribute name="id" type="xs:string" use="required"/>
  </xs:complexType>

  <xs:complexType name="DataDisabilityV1Type">
    <xs:sequence>
      <xs:element name="Disability" type="DisabilityV1Type" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="DisabilityRollType">
    <xs:annotation>
      <xs:documentation xml:lang="en">D100 TABLE OF HANDICAPS per type of wizard (Demonologist / Necromancer / EvilChaotic): Entry name = handicap code, value = d100 range ("01-09"). id = wizard type.</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="Entry" type="NamedString" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:attribute name="id" type="xs:string" use="required"/>
  </xs:complexType>

  <xs:complexType name="DataDisabilityRollType">
    <xs:sequence>
      <xs:element name="Table" type="DisabilityRollType" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <!-- ===================== MAGIC: NUMERIC RULES ===================== -->
  <xs:complexType name="MagicPointGainType">
    <xs:annotation>
      <xs:documentation xml:lang="en">MAGIC POINT GAIN per level completed: Race = RACE (Human / Elf / Dwarf / Halfling, or ALL for priests), Career = career code, Dice = die ("4D4", "2D4", "2D8", "1D4"), none if none. Only once per level reached, never twice for the same level in another school.</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="Race" type="xs:string"/>
      <xs:element name="Career" type="xs:string"/>
      <!-- Level concerned: "1" or "2-4" (Alchemist, whose first level yields less); absent = all levels. Career = career code without the level number (RULES-WORK_WIZARD). -->
      <xs:element name="Level" type="xs:string" minOccurs="0"/>
      <xs:element name="Dice" type="xs:string"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="DataMagicPointGainType">
    <xs:sequence>
      <xs:element name="Gain" type="MagicPointGainType" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="SpellLearningRuleType">
    <xs:annotation>
      <xs:documentation xml:lang="en">LEARNING RULE of a spell level: SpellLevel (P, 1-4), EPCost (50 for Petty, 200 x level), TestModifier applied to the Intelligence test (wizard) or Willpower test (priest): "x2", "x1", "-10", "-20", "-30"; AlwaysFail = d100 range that always fails ("96-100").</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="SpellLevel" type="xs:string"/>
      <xs:element name="EPCost" type="xs:string"/>
      <xs:element name="IntelligenceModifier" type="xs:string"/>
      <xs:element name="WillPowerModifier" type="xs:string"/>
      <xs:element name="AlwaysFail" type="xs:string" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="DataSpellLearningType">
    <xs:sequence>
      <xs:element name="Rule" type="SpellLearningRuleType" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <!-- ===================== EQUIPMENT V1 ===================== -->
  <!-- One line per combat modifier. Stat = code RULES-V1MOD_INITIATIVE / TOHIT / DAMAGE / PARRY;
       Value = text of the book ("-10", "+2", "+10/+20", "0**", "impossible"). -->
  <xs:complexType name="CombatModifierV1Type">
    <xs:sequence>
      <xs:element name="Stat" type="xs:string"/>
      <xs:element name="Value" type="xs:string"/>
    </xs:sequence>
  </xs:complexType>

  <!-- Band = code RULES-V1RANGE_POINTBLANK / SHORT / LONG / EXTREME; Distance in yards, "-" if absent;
       Strength = effective strength (ES) of the band ("4", "C", "-"), copied when the book gives only one. -->
  <xs:complexType name="RangeBandV1Type">
    <xs:sequence>
      <xs:element name="Band" type="xs:string"/>
      <xs:element name="Distance" type="xs:string"/>
      <xs:element name="Strength" type="xs:string" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="RangeBandsV1Type">
    <xs:sequence>
      <xs:element name="RangeBand" type="RangeBandV1Type" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="CombatModifiersV1Type">
    <xs:sequence>
      <xs:element name="CombatModifier" type="CombatModifierV1Type" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="EquipmentV1Type">
    <xs:sequence>
      <xs:element name="Description" type="LangString" maxOccurs="unbounded"/>
      <xs:element name="Category" type="xs:string"/>
      <xs:element name="SubCategory" type="xs:string" minOccurs="0"/>
      <!-- Price in GC / shillings / pence, formula accepted: "14GC", "35/-", "9d", "5GC 10/-". -->
      <xs:element name="Cost" type="xs:string" minOccurs="0"/>
      <xs:element name="Encumbrance" type="xs:string" minOccurs="0"/>
      <!-- Plentiful, Common, Average, Scarce, Rare, Very Rare. -->
      <xs:element name="Availability" type="xs:string" minOccurs="0"/>
      <!-- Melee and ranged weapons: optional combat modifiers as in the book (Initiative / to hit / damage / parry). -->
      <xs:element name="CombatModifiers" type="CombatModifiersV1Type" minOccurs="0"/>
      <!-- Ranged weapons: one line per range band (point blank, short, long, extreme); Reload = reload text of the book. -->
      <xs:element name="RangeBands" type="RangeBandsV1Type" minOccurs="0"/>
      <xs:element name="Reload" type="xs:string" minOccurs="0"/>
      <!-- Armour: armour points per zone, "0/1" for leather (reduces hits by 3 damage at most). -->
      <xs:element name="ArmourPoints" type="xs:string" minOccurs="0"/>
      <xs:element name="Locations" type="xs:string" minOccurs="0"/>
      <xs:element name="Note" type="xs:string" minOccurs="0"/>
      <xs:element name="Page" type="xs:string" minOccurs="0"/>
    </xs:sequence>
    <xs:attribute name="id" type="xs:string" use="required"/>
  </xs:complexType>

  <xs:complexType name="DataEquipmentV1Type">
    <xs:sequence>
      <xs:element name="EquipmentV1" type="EquipmentV1Type" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <!-- Availability according to population (Core p.292): % chance that an item of a given availability is on sale; failure = retry after a week. -->
  <xs:complexType name="AvailabilityRuleV1Type">
    <xs:sequence>
      <xs:element name="Availability" type="xs:string"/>
      <xs:element name="Below100" type="xs:string"/>
      <xs:element name="Below1000" type="xs:string"/>
      <xs:element name="Below10000" type="xs:string"/>
      <xs:element name="Over10000" type="xs:string"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="DataAvailabilityV1Type">
    <xs:sequence>
      <xs:element name="Rule" type="AvailabilityRuleV1Type" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <!-- Quality of clothing (Core p.293): factor applied to the price, encumbrance adjusts if needed. -->
  <xs:complexType name="ClothingQualityV1Type">
    <xs:sequence>
      <xs:element name="Quality" type="xs:string"/>
      <xs:element name="CostFactor" type="xs:string"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="DataClothingQualityV1Type">
    <xs:sequence>
      <xs:element name="Rule" type="ClothingQualityV1Type" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <!-- Artisan trade table (Core p.95): Roll = d100 range (also for randomly rolled Artisans and apprentices), Skill = skill specific to the trade (may be missing), ExitCode = exit specific to the trade (may be missing). The "Other" trade (96-00) has neither skill nor exit. -->
  <xs:complexType name="TradeV1Type">
    <xs:sequence>
      <xs:element name="Description" type="LangString"/>
      <xs:element name="Roll" type="xs:string"/>
      <xs:element name="Skill" type="xs:string" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="ExitCode" type="xs:string" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="Note" type="xs:string" minOccurs="0"/>
    </xs:sequence>
    <xs:attribute name="id" type="xs:string" use="required"/>
  </xs:complexType>

  <xs:complexType name="DataTradeV1Type">
    <xs:sequence>
      <xs:element name="Trade" type="TradeV1Type" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <!-- ===================== CREATION V1 ===================== -->
  <xs:complexType name="ClassV1Type">
    <xs:annotation>
      <xs:documentation xml:lang="en">CAREER CLASS at creation (Warrior / Ranger / Rogue / Academic). Requirement = one line per characteristic threshold (name = RULES-ATTR_*, value = minimum); RaceRequirement replaces the threshold for a race (Elf Rogue: I 65). Trappings = text of the book, Money = starting money formula (3D6 GC).</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="Description" type="LangString"/>
      <xs:element name="Explanation" type="LangString"/>
      <xs:element name="Requirement" type="NamedString" maxOccurs="unbounded"/>
      <xs:element name="RaceRequirement" minOccurs="0" maxOccurs="unbounded">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="Specie" type="xs:string"/>
            <xs:element name="Requirement" type="NamedString"/>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
      <xs:element name="Trappings" type="xs:string"/>
      <xs:element name="Money" type="xs:string"/>
      <xs:element name="Page" type="xs:string" minOccurs="0"/>
    </xs:sequence>
    <xs:attribute name="id" type="xs:string" use="required"/>
  </xs:complexType>

  <xs:complexType name="DataClassV1Type">
    <xs:sequence>
      <xs:element name="Class" type="ClassV1Type" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="SkillRollEntryV1Type">
    <xs:annotation>
      <xs:documentation xml:lang="en">D100 TABLE OF STARTING SKILLS: one Entry = one skill in the column of a race for a class. Class = class code, Specie = race (RULES-SPECIE_*), Skill name = skill code, value = CHANCE (number of d100 values occupied, like DATA_CAREER_ROLL; ranges are never entered). A skill absent from a column is a dash in the book.</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="Class" type="xs:string"/>
      <xs:element name="Specie" type="xs:string"/>
      <xs:element name="Skill" type="NamedString"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="DataSkillRollV1Type">
    <xs:sequence>
      <xs:element name="Entry" type="SkillRollEntryV1Type" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="SkillCountAgeEntryV1Type">
    <xs:annotation>
      <xs:documentation xml:lang="en">NUMBER OF STARTING SKILLS = D4 + Modifier, according to race and age bracket (not cumulative: the value of the bracket is taken). A missing bracket = 0.</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="Specie" type="xs:string"/>
      <xs:element name="AgeMin" type="xs:string"/>
      <xs:element name="AgeMax" type="xs:string"/>
      <xs:element name="Modifier" type="xs:string"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="DataSkillCountAgeV1Type">
    <xs:sequence>
      <xs:element name="Entry" type="SkillCountAgeEntryV1Type" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <!-- ===================== DRUID FAMILIARS ===================== -->
  <xs:complexType name="FamiliarV1Type">
    <xs:annotation>
      <xs:documentation xml:lang="en">FAMILIAR TABLE (d100, rolled once on becoming a level 1 Druidic Priest): Range, Animal (label), Skill1 gained at level 1 and Skill2 at level 2 (free, skill codes; Note of the skill as text), Armour (Any / Leather / None), Shield (1 / 0), ForbiddenWeapons (forbidden weapon types, e.g. 2-h, firearms, blunt, sharp, missile; empty = none), TimesPlaces (times and places of communion, e.g. night, forest), Diet = HERBIVORE / PREDATOR / FISH_EATER / OMNIVORE.</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="Range" type="xs:string"/>
      <xs:element name="Animal" type="LangString"/>
      <xs:element name="Skill1" type="xs:string"/>
      <xs:element name="Skill2" type="xs:string"/>
      <xs:element name="SkillNote" type="xs:string" minOccurs="0"/>
      <xs:element name="Armour" type="xs:string"/>
      <xs:element name="Shield" type="xs:string"/>
      <xs:element name="ForbiddenWeapons" type="xs:string" minOccurs="0"/>
      <xs:element name="TimesPlaces" type="xs:string"/>
      <xs:element name="Diet" type="xs:string"/>
    </xs:sequence>
    <xs:attribute name="id" type="xs:string" use="required"/>
  </xs:complexType>

  <xs:complexType name="DataFamiliarV1Type">
    <xs:sequence>
      <xs:element name="Familiar" type="FamiliarV1Type" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <!-- ===================== PRIEST ADVANCEMENT TABLES ===================== -->
  <xs:complexType name="PriestAdvanceEntryType">
    <xs:annotation>
      <xs:documentation xml:lang="en">LINE OF A PRIEST ADVANCEMENT TABLE (modified d100 roll, bought for 100 XP x level): Range = roll range ("01-05", "105-999" for 105 or more), Result = effect code (WRATH = Wrath of the gods, UNWORTHY = new basic career imposed, TRIAL = trial to accomplish, NOT_READY = retry after 100 XP, ADVANCE = next level), NewCareerClasses = classes of the imposed career (one line per class, D6 in Dice), EPGift = XP given ("D10x10"), FatePoint = Fate points given, Blessing = 1 if the character is blessed, FamiliarSkills = familiar skills gained (0, 1 or 2, druid only). The range "95-104" of the book is entered as 96-104 (95 belongs to the line 81-95).</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="Range" type="xs:string"/>
      <xs:element name="Result" type="xs:string"/>
      <xs:element name="NewCareerClass" type="NamedString" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="EPGift" type="xs:string" minOccurs="0"/>
      <xs:element name="FatePoint" type="xs:string" minOccurs="0"/>
      <xs:element name="Blessing" type="xs:string" minOccurs="0"/>
      <xs:element name="FamiliarSkills" type="xs:string" minOccurs="0"/>
      <xs:element name="Explanation" type="LangString"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="PriestAdvanceTableType">
    <xs:annotation>
      <xs:documentation xml:lang="en">id = CLERIC or DRUID. The roll is modified by the GM: +10 % exemplary life, -10 % mere lip service, +15 % heroic deed (cleric), +5 % protection of a wood (druid).</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="Entry" type="PriestAdvanceEntryType" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:attribute name="id" type="xs:string" use="required"/>
  </xs:complexType>

  <xs:complexType name="DataPriestAdvanceV1Type">
    <xs:sequence>
      <xs:element name="Table" type="PriestAdvanceTableType" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <!-- ===================== DATA_BOOK ===================== -->
  <xs:element name="DATA_BOOK">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="CODE_BOOK" type="xs:string"/>
        <xs:element name="BOOK" type="xs:string"/>
        <xs:element name="BOOKNAME" type="xs:string" minOccurs="0"/>
        <xs:element name="language" type="xs:string"/>
        <xs:element name="VERSION" type="xs:string"/>
        <xs:element name="OFFICIAL" type="xs:string"/>
        <xs:element name="COMPLETE" type="xs:string"/>
        <xs:element name="DISCLAIMER" type="xs:string" minOccurs="0"/>
        <xs:choice minOccurs="0" maxOccurs="unbounded">
          <!-- Common blocks -->
          <xs:element name="DATA_ATTRIBUT" type="DataAttributType"/>
          <xs:element name="DATA_SKILL_SPECIALIZATION" type="DataSkillSpecializationType"/>
          <xs:element name="DATA_SPECIE" type="DataSpecieType"/>
          <xs:element name="DATA_RACE" type="DataRaceType"/>
          <xs:element name="DATA_PERSONAL_TABLE" type="DataPersonalTableType"/>
          <xs:element name="DATA_RULE" type="DataRuleType"/>
          <xs:element name="DATA_RULE_SPECIE" type="DataRuleSpecieType"/>
          <xs:element name="DATA_RULE_SKILL_ROLL" type="DataRuleSkillRollType"/>
          <xs:element name="DATA_CAREER_ROLL" type="DataCareerRollType"/>
          <!-- V1-specific blocks -->
          <xs:element name="DATA_CAREER_V1" type="DataCareerV1Type"/>
          <xs:element name="DATA_CAREER_LINK_V1" type="DataCareerLinkV1Type"/>
          <xs:element name="DATA_SKILL_V1" type="DataSkillV1Type"/>
          <xs:element name="DATA_SPELL_V1" type="DataSpellV1Type"/>
          <xs:element name="DATA_DEITY_V1" type="DataDeityV1Type"/>
          <xs:element name="DATA_CULT_V1" type="DataCultV1Type"/>
          <xs:element name="DATA_DISABILITY_V1" type="DataDisabilityV1Type"/>
          <xs:element name="DATA_DISABILITY_ROLL_V1" type="DataDisabilityRollType"/>
          <xs:element name="DATA_MAGIC_POINT_GAIN_V1" type="DataMagicPointGainType"/>
          <xs:element name="DATA_SPELL_LEARNING_V1" type="DataSpellLearningType"/>
          <xs:element name="DATA_EQUIPMENT_V1" type="DataEquipmentV1Type"/>
          <xs:element name="DATA_TRADE_V1" type="DataTradeV1Type"/>
          <xs:element name="DATA_AVAILABILITY_V1" type="DataAvailabilityV1Type"/>
          <xs:element name="DATA_CLOTHING_QUALITY_V1" type="DataClothingQualityV1Type"/>
          <xs:element name="DATA_CLASS_V1" type="DataClassV1Type"/>
          <xs:element name="DATA_SKILL_ROLL_V1" type="DataSkillRollV1Type"/>
          <xs:element name="DATA_SKILL_COUNT_AGE_V1" type="DataSkillCountAgeV1Type"/>
          <xs:element name="DATA_PRIEST_ADVANCE_V1" type="DataPriestAdvanceV1Type"/>
          <xs:element name="DATA_FAMILIAR_V1" type="DataFamiliarV1Type"/>
        </xs:choice>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
</xs:schema>
