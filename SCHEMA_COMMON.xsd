<?xml version="1.0" encoding="UTF-8"?>
<!--
  SCHEMA_COMMON.xsd
  Types XSD shared between SCHEMA_WFRP4.xsd and SCHEMA_WFRP5.xsd.
  Generated from an audit of the DATABASE/WFRP4 and DATABASE/WFRP5 corpus,
  see GABARIT_LIVRE_XML.md for the entry conventions.

  General convention observed throughout the corpus: the text content of tags is
  stored with literal English quotation marks included in the text node (e.g. "Talent
  name"), a consequence of the in-house parser (xmlexportimport.pas) that strips them
  when reading. The XSD validates ONLY the structure / presence of tags, not this detail of
  quoting convention (xs:string accepts the quotes like any other character).

-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           elementFormDefault="qualified"
           attributeFormDefault="unqualified">

  <!-- ===================== Base simple types ===================== -->

  <!-- ===================== Modifiers (TypesEffet table of chargemodificateur.pas) =====================
       The 16 effect tags read by LitModificateurNoeud, all of the same flexible type: name=
       (target), skill= (ModifyWeapon), if= (filter), Type/Cible/Facteur/Filtre (generic format
       <Modificateur/>). To be referenced by <xs:group ref="ModificateursEffets"/> in any block
       that accepts modifiers, never by isolated declarations: two declarations
       of the same tag with different types in one block are refused. -->
  <xs:complexType name="ModificateurEffetType">
    <xs:annotation>
      <xs:documentation xml:lang="en">NUMERIC EFFECT of a source (talent, weapon, armour, quality, craftsmanship, mutation, disease, career bonus). The CONTENT is the value: signed integer (+10, -1, 1), die face (10 = 1d10 for ModifyCaracAleatoire), or text ("Bonus": display meaning of ModifySkill). The TAG says what is modified, name= says which target. Single table in the code: TypesEffet (chargemodificateur.pas). Examples: &lt;ModifyCarac name="RULES-ATTR_WP"&gt;+10&lt;/ModifyCarac&gt;; &lt;ModifyWeapon name="RULES-WTYPE_SWORD" skill="RULES-COMP_MELEE__BASIC"&gt;+10&lt;/ModifyWeapon&gt;; &lt;ModifyDamage name="CT" if="DWARF-COND_01"&gt;1&lt;/ModifyDamage&gt;.</xs:documentation>
    </xs:annotation>
    <xs:simpleContent>
      <xs:extension base="xs:string">
        <xs:attribute name="name" type="xs:string" use="optional">
          <xs:annotation>
            <xs:documentation xml:lang="en">Target of the effect. Its meaning depends on the tag: characteristic code (RULES-ATTR_WP) for ModifyCarac; skill code (RULES-COMPCHARM, or family RULES-COMPFOCAL_*) for ModifySkill; weapon type code (RULES-WTYPE_SWORD) for ModifyWeapon; armour location (RULES-ARMOL_HEAD) for ModifArmour; CC or CT (melee or ranged weapons) for ModifyDamage; '*' for ModifyDamageReceived; fixed word for ModifyAccurate (ACCURATE), ModifyReloadRate/Min (RELOAD), ModifyHands (HANDS).</xs:documentation>
          </xs:annotation>
        </xs:attribute>
        <xs:attribute name="skill" type="xs:string" use="optional">
          <xs:annotation>
            <xs:documentation xml:lang="en">ModifyWeapon only: limits the effect to ONE skill when the weapon type has several (skill code).</xs:documentation>
          </xs:annotation>
        </xs:attribute>
        <xs:attribute name="if" type="xs:string" use="optional">
          <xs:annotation>
            <xs:documentation xml:lang="en">Condition of application: code of a Condition of the book (DATA_CONDITION, e.g. DWARF-COND_02). A conditional effect NEVER modifies a total: it is displayed as a note. A value of 0 is only allowed with if=.</xs:documentation>
          </xs:annotation>
        </xs:attribute>
        <xs:attribute name="Type" type="xs:string" use="optional">
          <xs:annotation>
            <xs:documentation xml:lang="en">Generic format &lt;Modificateur/&gt;: tag of the effect to produce (ModifArmour, ModifySkill, ModifyWeapon...). Used for craftsmanships and talents without a dedicated tag.</xs:documentation>
          </xs:annotation>
        </xs:attribute>
        <xs:attribute name="Cible" type="xs:string" use="optional">
          <xs:annotation>
            <xs:documentation xml:lang="en">Generic format &lt;Modificateur/&gt;: equivalent of name= (the targeted code).</xs:documentation>
          </xs:annotation>
        </xs:attribute>
        <xs:attribute name="Facteur" type="xs:string" use="optional">
          <xs:annotation>
            <xs:documentation xml:lang="en">Generic format &lt;Modificateur/&gt;: the value of the effect (signed integer).</xs:documentation>
          </xs:annotation>
        </xs:attribute>
        <xs:attribute name="Filtre" type="xs:string" use="optional">
          <xs:annotation>
            <xs:documentation xml:lang="en">Generic format &lt;Modificateur/&gt;: equivalent of skill=, or condition code.</xs:documentation>
          </xs:annotation>
        </xs:attribute>
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>

  <xs:group name="ModificateursEffets">
    <xs:choice>
      <xs:element name="ModifyCarac" type="ModificateurEffetType">
        <xs:annotation>
          <xs:documentation xml:lang="en">Adds the value to a characteristic (name = RULES-ATTR_xx). +10 = 10 points.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="ModifyCaracAleatoire" type="ModificateurEffetType">
        <xs:annotation>
          <xs:documentation xml:lang="en">Like ModifyCarac, but the value is a DIE FACE (10 = 1d10), rolled ONCE when the element is added to the sheet and remembered (diseases, afflictions).</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="ModifySkill" type="ModificateurEffetType">
        <xs:annotation>
          <xs:documentation xml:lang="en">Numeric bonus on a skill (name = skill code, or family _*). The text "Bonus" or a negative value only changes the display.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="ModifySkillAttribut" type="ModificateurEffetType">
        <xs:annotation>
          <xs:documentation xml:lang="en">Same bonus on ALL the skills linked to a characteristic (name = RULES-ATTR_xx): broadcast by attribute. Outside the generic engine.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="ModifyWeapon" type="ModificateurEffetType">
        <xs:annotation>
          <xs:documentation xml:lang="en">Weapon skill bonus for a weapon TYPE (name = RULES-WTYPE_xx); skill= limits it to one skill.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="ModifyDamage" type="ModificateurEffetType">
        <xs:annotation>
          <xs:documentation xml:lang="en">Damage: name = CC (melee) or CT (ranged), SORT for a spell.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="Modificateur" type="ModificateurEffetType">
        <xs:annotation>
          <xs:documentation xml:lang="en">Generic format with Type/Cible/Facteur/Filtre attributes, for effects without a tag of their own.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="ModifArmour" type="ModificateurEffetType">
        <xs:annotation>
          <xs:documentation xml:lang="en">Extra armour points on a location (name = RULES-ARMOL_HEAD/ARM/BODY/LEG, or RULES-ARMOL_SHIELD for the Shield quality).</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="ModifBoat" type="ModificateurEffetType">
        <xs:annotation>
          <xs:documentation xml:lang="en">Boat modifier (name = M for manoeuvrability).</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="ModifyTestSL" type="ModificateurEffetType">
        <xs:annotation>
          <xs:documentation xml:lang="en">Success Levels bonus on a skill test (name = skill or family, e.g. RULES-COMPFOCAL_*).</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="ModifyCN" type="ModificateurEffetType">
        <xs:annotation>
          <xs:documentation xml:lang="en">Modifies the Casting Number (name = spell family, e.g. RULES-LORE_*).</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="ModifyDamageReceived" type="ModificateurEffetType">
        <xs:annotation>
          <xs:documentation xml:lang="en">Modifies the damage received (name = *).</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="ModifyAccurate" type="ModificateurEffetType">
        <xs:annotation>
          <xs:documentation xml:lang="en">Accurate quality: Test bonus (name = ACCURATE).</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="ModifyReloadRate" type="ModificateurEffetType">
        <xs:annotation>
          <xs:documentation xml:lang="en">Reload quality: changes the reload time (name = RELOAD).</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="ModifyReloadMin" type="ModificateurEffetType">
        <xs:annotation>
          <xs:documentation xml:lang="en">Floor of the reload time (name = RELOAD).</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="ModifyGrapple" type="ModificateurEffetType">
        <xs:annotation>
          <xs:documentation xml:lang="en">Percentage bonus to grapple tests (name = GRAPPLE). Loaded and displayed only, never computed.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="ModifyHands" type="ModificateurEffetType">
        <xs:annotation>
          <xs:documentation xml:lang="en">Number of hands needed (name = HANDS; -1 = one hand fewer).</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="ModifySkillGear" type="ModificateurEffetType">
        <xs:annotation>
          <xs:documentation xml:lang="en">Skill bonus linked to equipment: feeds the "with equipment" column of the PDF (Practical/Unreliable), never the Total.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="AddSkillToCareer" type="ModificateurEffetType">
        <xs:annotation>
          <xs:documentation xml:lang="en">Adds the skill (name) to the career skills of ALL the character's careers, at the tier given by the value (1 = from level 1). E.g. Perfect Pitch -&gt; Chant.</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:choice>
  </xs:group>

  <!-- Simple string, without attribute (Skill, Attribut, Max, PDF, etc. in "flat" position) -->
  <xs:simpleType name="PlainString">
    <xs:restriction base="xs:string"/>
  </xs:simpleType>

  <!-- Text element with a mandatory language attribute (Description, Explanation, Test, Short...) -->
  <xs:complexType name="LangString">
    <xs:simpleContent>
      <xs:extension base="xs:string">
        <xs:attribute name="language" type="xs:string" use="required"/>
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>

  <!-- Text element with an optional language attribute (rare single-sample blocks
       where the attribute is not systematically confirmed) -->
  <xs:complexType name="LangStringOpt">
    <xs:simpleContent>
      <xs:extension base="xs:string">
        <xs:attribute name="language" type="xs:string" use="optional"/>
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>

  <!-- Text element with a mandatory name attribute (Skill name=, Talent name=, Cost name=,
       Chance name=, Specie name=, Attribut name=, Alternative name=...) -->
  <xs:complexType name="NamedString">
    <xs:simpleContent>
      <xs:extension base="xs:string">
        <xs:attribute name="name" type="xs:string" use="required"/>
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>

  <!-- Like NamedString but the name attribute is optional (Modifier in DATA_ARMOR_BONUS:
       present when the bonus targets a specific skill / characteristic, absent otherwise).
       The optional if= attribute is seen on ModifyDamage/ModifySkill in DATA_CRAFTMANSHIP
       (condition of application of the craftsmanship, e.g. BOOK_DWARF_PLAYERS_GUIDE.Xml). -->
  <xs:complexType name="OptionallyNamedString">
    <xs:simpleContent>
      <xs:extension base="xs:string">
        <xs:attribute name="name" type="xs:string" use="optional"/>
        <xs:attribute name="if" type="xs:string" use="optional"/>
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>

  <xs:complexType name="ItemEntryType">
    <xs:simpleContent>
      <xs:extension base="xs:string">
        <xs:attribute name="name" type="xs:string" use="required"/>
        <xs:attribute name="quantite" type="xs:string" use="optional"/>
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>

  <!-- ===================== Reusable factorised blocks ===================== -->

  <!-- Description + Explanation, the most frequent pair of the corpus -->
  <xs:group name="DescriptionExplanationGroup">
    <xs:sequence>
      <xs:element name="Description" type="LangString"/>
      <xs:element name="Explanation" type="LangString"/>
    </xs:sequence>
  </xs:group>

  <!-- SUBCHAPTER_ITEM: Item name=... value = level that unlocks the item, repeatable -->
  <xs:complexType name="SubchapterItem">
    <xs:sequence>
      <xs:element name="Item" type="ItemEntryType" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <!-- SUBCHAPTER_SKILL: Skill name=... -->
  <xs:complexType name="SubchapterSkill">
    <xs:sequence>
      <xs:element name="Skill" type="NamedString" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <!-- SUBCHAPTER_TALENT: Talent name=... -->
  <xs:complexType name="SubchapterTalent">
    <xs:sequence>
      <xs:element name="Talent" type="NamedString" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <!-- SUBCHAPTER_ATTR: Attribut name=... -->
  <xs:complexType name="SubchapterAttr">
    <xs:sequence>
      <xs:element name="Attribut" type="NamedString" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <!-- ===================== DATA_TALENT ===================== -->
  <!--
    Mandatory (100% of the corpus): Talent[id], Test, Description, PDF, Explanation, Max,
    Skill, Short. (Attribut removed: ModifyCarac is authoritative.)
    Optional: Trait, XpDivisor, XpMultiplier, XpFloor, Magic, SpellMode (co-occurring),
    Modificateur, XpFree, Effet, ModifyCarac, AddSkill, ModifySkill (isolated cases, observed
    inserted between Attribut and Description in the real order of the file).
    IMPORTANT (safeguard rule): <Generique> is FORBIDDEN in this block, even as an option.
    A talent with <Generique> is a wrongly entered specialisation: it must go in
    DATA_TALENT_SPECIALIZATION (see GABARIT_LIVRE_XML.md; a bug fixed on 9 talents of
    HORNE/GRIM/TRIBE). This XSD does NOT declare <Generique> as a possible element
    of TalentType: any <Generique> present causes a validation error
    "unexpected element", which is the intended behaviour.
  -->
  <!--
    Real order checked on BOOK_RULESBOOK.Xml (19 talents scanned):
    Description/Short/Explanation/Skill/Max/PDF/Test (the mandatory base, stable order),
    BUT the extras (Effet, ModifyCarac, AddSkill, ModifySkill, Modificateur, XpFree, Trait,
    Magic, SpellMode, XpDivisor, XpMultiplier, XpFloor) turned out to be inserted at
    different positions depending on the talent (before Description, between Skill and Max, after
    Test...), with no single fixed position in the corpus. Policy kept: the mandatory
    base stays a strict xs:sequence (guaranteeing the presence and order of the core of the
    block), the extras are grouped in a repeatable xs:choice AFTER the base rather than being
    frozen at a position that would break the validation of talents already entered correctly.
    This is a deliberately documented relaxation of the rule "strict xs:sequence
    everywhere": the variance is a fact of the corpus (manual entry spread over
    several months/books), not an error to fix.
  -->
  <!--
    The extras (Effet, ModifyCarac, AddSkill, ModifySkill, Modificateur, XpFree, Trait,
    Magic, SpellMode, XpDivisor, XpMultiplier, XpFloor) turned out to be inserted at
    DIFFERENT positions depending on the talent (before Description, between Skill and Max, after
    Test...), checked on BOOK_RULESBOOK.Xml, with no single fixed position in the corpus.
    A strict xs:sequence for the base (Description/Short/Explanation/Skill/Max/PDF/Test)
    with the extras only at the end of the block wrongly rejects talents that are already valid. The
    content is therefore modelled as an unordered, repeatable xs:choice: it is a
    DELIBERATE AND DOCUMENTED RELAXATION of the rule "strict xs:sequence
    everywhere", justified by the fact that the variance is a
    fact of the corpus (manual entry spread over several months/books), not an error to
    fix. The whitelist of valid tags stays strict (it is what blocks
    <Generique>, the bug targeted here); only the ORDER and the exact number
    of occurrences of the mandatory fields are no longer checked by the XSD for this block.
  -->
  <!--
    DISPLAY GROUPS OF THE TALENT SHEET IN WINLIVRE.
    The XSD drives nothing in WinLivre: the groups are hard-coded (winlivre.pas, EnGroupes). They do not
    change the XML, only the fields shown on screen; a field that is already filled always stays visible.
      Magic   : Magic, SpellTypes, XpMultiplier, XpFloor, XpDivisor, XpFree, SpellMode (rare: 5 to 7 talents per version)
      Level   : GrantAt, LoseAt (2 occurrences, Nations of Mankind)
      Engine  : Effet block (Engine effect)
      V4,V5   : PDF (absent in V2, tag always empty in V5), Trait (79 talents V4, 62 V5, never in V2)
    The three "family" checkboxes of the sheet (Magic, Engine, Level) show a group even when it is empty.
    Same principles for the other sheets: Skill (Basic V1,V2,V4; RelatedTalents V2); Trapping V4
    (groups Animal, Vehicle, Trade, Quality); Career V4 / V5 (groups Species, Variant); Ethnicity
    (Attachment V4,V5: Nationality, PictureLevel; Story V2: Background, RoleplayingHints).
  -->
  <xs:complexType name="TalentType">
    <xs:choice minOccurs="1" maxOccurs="unbounded">
      <xs:element name="Description" type="LangString"/>
      <xs:element name="Short" type="LangString">
        <xs:annotation>
          <xs:documentation xml:lang="en">One-line summary for lists. Empty most of the time.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="Explanation" type="LangString"/>
      <xs:element name="Max" type="PlainString">
        <xs:annotation>
          <xs:documentation xml:lang="en">Maximum number of takings: integer ("1"), "99" = no practical limit, or a formula on a characteristic bonus, "(BATTR_I)" = Initiative Bonus, "(BATTR_Fel)"...</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="PDF" type="PlainString">
        <xs:annotation>
          <xs:documentation xml:lang="en">Skill code (RULES-COMP_MELEE__*, RULES-COMP_PERFORM__*, etc.) whose talent is flagged by an asterisk on the PDF. WITHOUT book prefix. Empty = no asterisk.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="Test" type="LangString">
        <xs:annotation>
          <xs:documentation xml:lang="en">Test that the talent modifies, as free text ("Melee when defending"). Empty most of the time.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="Effet" type="EffetType">
        <xs:annotation>
          <xs:documentation xml:lang="en">Talent effect outside the generic engine: attributes Cible (effect name), Forme (Additif, Drapeau, ProportionnelAttribut), Facteur, Carac (for ProportionnelAttribut). E.g. &lt;Effet Cible="BonusEncomb" Forme="Additif" Facteur="2"/&gt;.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:group ref="ModificateursEffets"/>
      
      <xs:element name="XpFree" type="PlainString">
        <xs:annotation>
          <xs:documentation xml:lang="en">Number of free spells before the rate applies: integer or formula ("(BATTR_WP)").</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="Trait" type="PlainString">
        <xs:annotation>
          <xs:documentation xml:lang="en">"1" = creature trait: not selectable at creation (Frightening, Armour...). Also used for an ethnicity talent.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="FreeSpecialisation" type="PlainString">
        <xs:annotation>
          <xs:documentation xml:lang="en">"1" = the player may create a specialisation that is not in the book (+Specialisation button): Craftsman, Etiquette, Savant... Absent = refused (Invoke, Arcane Magic, closed lists). On the GENERIC entry only.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="Magic" type="PlainString">
        <xs:annotation>
          <xs:documentation xml:lang="en">Opening priority of the spell catalogue: 1 = exclusive (a Domain rules out the rest); 2 = cumulative (Miracle, Petty Magic); 0 = never opens (Blessing). Carried by the GENERIC entry, inherited by the specialisations.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="SpellMode" type="PlainString">
        <xs:annotation>
          <xs:documentation xml:lang="en">How spells arrive at purchase: AUTO = all the spells that cite the talent are added (Blessings); CHOICE = one "to choose" line (Miracles); NONE = nothing, they are bought (Domains, Petty Magic).</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="SpellTypes" type="PlainString">
        <xs:annotation>
          <xs:documentation xml:lang="en">TypSpell values that this talent opens, separated by commas, in English ("Arcane Magic,Domain Magic,Ritual"). On the generic entry.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="XpDivisor" type="PlainString">
        <xs:annotation>
          <xs:documentation xml:lang="en">Divisor of the spell rate: cost = XpMultiplier x max(XpFloor, ceiling(n / XpDivisor)), n = spells already known in the group. Integer ("5") or formula ("(BATTR_Int)").</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="XpMultiplier" type="PlainString">
        <xs:annotation>
          <xs:documentation xml:lang="en">Multiplier of the XP cost of a spell (100, 50). ABSENT = free (Blessings declare nothing): never write 0 everywhere.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="XpFloor" type="PlainString">
        <xs:annotation>
          <xs:documentation xml:lang="en">Floor of the term max(XpFloor, ceiling(n/XpDivisor)) in the cost of a spell.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="XpOffset" type="PlainString">
        <xs:annotation>
          <xs:documentation xml:lang="en">Offset added to the tier: cost = XpMultiplier x max(XpFloor, ceiling(n/XpDivisor) + XpOffset). Absent = 0. Used by Witch! (WFRP5): 150 XP for the second spell, then +50 each (XpMultiplier 50, XpDivisor 1, XpOffset 2).</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="GrantAt" type="PlainString">
        <xs:annotation>
          <xs:documentation xml:lang="en">Automatic grant by a career: "CAREER-CODE/LEVEL" (RULES-WORK_APOTHECARY/3). The talent is added when the character reaches that level.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="LoseAt" type="PlainString">
        <xs:annotation>
          <xs:documentation xml:lang="en">Automatic removal: "CAREER-CODE/LEVEL" (RULES-WORK_APOTHECARY/4): the talent is removed at that level (see GrantAt).</xs:documentation>
        </xs:annotation>
      </xs:element>
          <!-- Page of the source book that gives the sheet. Free text: "38", "45-46". -->
      <xs:element name="Page" type="PlainString" minOccurs="0"/>
    </xs:choice>
    <xs:attribute name="id" type="xs:string" use="required"/>
  </xs:complexType>

  <!-- <Effet Cible="..." Forme="..." Facteur="..." Carac="..."/> seen on some talents
       (e.g. Pure Soul): free attributes, all optional depending on the effect described. -->
  <xs:complexType name="EffetType">
    <xs:attribute name="Cible" type="xs:string" use="optional"/>
    <xs:attribute name="Forme" type="xs:string" use="optional"/>
    <xs:attribute name="Facteur" type="xs:string" use="optional"/>
    <xs:attribute name="Carac" type="xs:string" use="optional"/>
  </xs:complexType>

  <xs:complexType name="DataTalentType">
    <xs:sequence>
      <xs:element name="Talent" type="TalentType" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <!-- ===================== DATA_TALENT_SPECIALIZATION ===================== -->
  <!--
    Mandatory: Talent[id], Description. Almost mandatory: Generique (present in
    the vast majority of cases; kept at minOccurs=0 because one case of the corpus lacks it).
    Rare optional: Trait.
    No Attribut/Explanation/Skill/Max/PDF/Test in this block (xmlexportimport.pas
    does not load them).
  -->
  <!-- Trait, when present, is seen BEFORE Description (e.g. RULES-T_AFRAID__ELF): grouped as a
       free choice rather than frozen at a single position. -->
  <xs:complexType name="TalentSpecializationType">
    <xs:choice minOccurs="1" maxOccurs="unbounded">
      <xs:element name="Description" type="LangString"/>
      <xs:element name="Generique" type="PlainString"/>
      <xs:element name="Trait" type="PlainString"/>
          <!-- Page of the source book that gives the sheet. Free text: "38", "45-46". -->
      <xs:element name="Page" type="PlainString" minOccurs="0"/>
    </xs:choice>
    <xs:attribute name="id" type="xs:string" use="required"/>
  </xs:complexType>

  <xs:complexType name="DataTalentSpecializationType">
    <xs:sequence>
      <xs:element name="Talent" type="TalentSpecializationType" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <!-- ===================== DATA_SPELL / DATA_SPELL_TALENT ===================== -->
  <!--
    Mandatory: Sort[id], Description, Explanation, Target, Range, Duration, Talent,
    Level, TypSpell.
    Optional CULTE, WFRP5 only (added through SpellCulteType in SCHEMA_WFRP5.xsd;
    the base type here stays the common WFRP4/WFRP5 core).
  -->
  <xs:complexType name="SortType">
    <xs:sequence>
      <xs:element name="Description" type="LangString"/>
      <xs:element name="Explanation" type="LangString" minOccurs="0"/>
      <!-- Empty when the book gives none (ritual, blessing): WinLivre does not write empty tags. -->
      <xs:element name="Target" type="PlainString" minOccurs="0"/>
      <xs:element name="Duration" type="PlainString" minOccurs="0"/>
      <xs:element name="Range" type="PlainString" minOccurs="0"/>
      <xs:element name="Talent" type="PlainString" minOccurs="0"/>
      <xs:element name="Level" type="PlainString" minOccurs="0"/>
      <xs:element name="TypSpell" type="PlainString"/>
      <xs:element name="XpFixed" type="PlainString" minOccurs="0"/>
      <xs:element name="CULTE" type="PlainString" minOccurs="0"/>
          <!-- Page of the source book that gives the sheet. Free text: "38", "45-46". -->
      <xs:element name="Page" type="PlainString" minOccurs="0"/>
    </xs:sequence>
    <xs:attribute name="id" type="xs:string" use="required"/>
  </xs:complexType>

  <xs:complexType name="DataSpellType">
    <xs:annotation>
      <xs:documentation xml:lang="en">SPELLS: one Sort per spell, id = code (book prefix). Target, Duration, Range, Level (Casting Number), Talent (talent that opens access: domain, petty magic, miracle), TypSpell (magic family, in English). See GABARIT_LIVRE_XML.md, section DATA_SPELL. Spell-talent links added by ANOTHER book are declared in DATA_SPELL_TALENT.</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="Sort" type="SortType" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <!-- DATA_SPELL_TALENT: wrapper containing N repeated Sort[id], each with a single inner
       Talent (checked on BOOK_RULESBOOK.Xml: Sort id="RULES-BENED_BLESSING_OF_RECUPERATION" > Talent).
       Entered by hand in the XML only (WinLivre does not edit it), see GABARIT_LIVRE_XML.md. -->
  <xs:complexType name="SpellTalentEntryType">
    <xs:sequence>
      <xs:element name="Talent" type="PlainString"/>
    </xs:sequence>
    <xs:attribute name="id" type="xs:string" use="required"/>
  </xs:complexType>

  <xs:complexType name="DataSpellTalentType">
    <xs:sequence>
      <xs:element name="Sort" type="SpellTalentEntryType" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <!-- ===================== DATA_CONDITION ===================== -->
  <!-- Conditions (if="id") of the modifiers: one entry per condition, its label in the DATA_LABEL of the book.
       Kind: Information, Optional or Conditional. Portable block: each book declares its own. -->
  <xs:complexType name="ConditionEntryType">
    <xs:sequence>
      <xs:element name="Kind" type="PlainString"/>
          <!-- Page of the source book that gives the sheet. Free text: "38", "45-46". -->
      <xs:element name="Page" type="PlainString" minOccurs="0"/>
    </xs:sequence>
    <xs:attribute name="id" type="xs:string" use="required"/>
  </xs:complexType>

  <xs:complexType name="DataConditionType">
    <xs:sequence>
      <xs:element name="Condition" type="ConditionEntryType" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <!-- ===================== DATA_CAREER ===================== -->
  <!--
    Mandatory: Career[id], Description, Explanation, Skill, Class,
    SUBCHAPTER_LEVEL(Level/Description/Salary), SUBCHAPTER_ATTR(Attribut),
    SUBCHAPTER_SKILL(Skill), SUBCHAPTER_TALENT(Talent), SUBCHAPTER_ITEM(Item).
    Optional: Parent, Ammunition, PictureLevel.
    Class is NOT a closed enum (extensible per book, prefix BOOK-CLASS_xxx): it stays
    a free xs:string.
  -->
  <xs:complexType name="CareerLevelType">
    <xs:sequence>
      <xs:element name="Description" type="LangString"/>
      <!-- Feminine form of the level name (optional). Absent = Description serves both sexes. -->
      <xs:element name="DescriptionFeminine" type="LangString" minOccurs="0"/>
      <xs:element name="Salary" type="PlainString"/>
    </xs:sequence>
    <xs:attribute name="id" type="xs:string" use="required"/>
  </xs:complexType>

  <xs:complexType name="SubchapterLevel">
    <xs:sequence>
      <xs:element name="Level" type="CareerLevelType" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <!-- Parent turned out to be positioned near Ammunition/PictureLevel (just before
       SUBCHAPTER_LEVEL) in some books (BOOK_DWARF_PLAYERS_GUIDE.Xml) rather than after
       Explanation: grouped with Ammunition/PictureLevel as a free choice. -->
  <xs:complexType name="CareerType">
    <xs:sequence>
      <xs:element name="Description" type="LangString"/>
      <xs:element name="Explanation" type="LangString"/>
      <!-- Skill ("signature" skill): minOccurs=0 because absent in WFRP5
           (BOOK_RULESBOOK.Xml WFRP5, checked on Apothecary RULES-WORK_APOTHECARY), present and
           mandatory in the WFRP4 corpus. -->
      <xs:element name="Skill" type="PlainString" minOccurs="0"/>
      <xs:element name="Class" type="xs:string"/>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:element name="Parent" type="PlainString"/>
        <xs:element name="Ammunition" type="PlainString"/>
        <xs:element name="PictureLevel" type="PlainString"/>
        <!-- Specie: races or ethnicities open to this career, repeatable. -->
        <xs:element name="Specie" type="PlainString"/>
      </xs:choice>
      <xs:element name="SUBCHAPTER_LEVEL" type="SubchapterLevel"/>
      <xs:element name="SUBCHAPTER_ATTR" type="SubchapterAttr"/>
      <xs:element name="SUBCHAPTER_SKILL" type="SubchapterSkill"/>
      <xs:element name="SUBCHAPTER_TALENT" type="SubchapterTalent"/>
      <xs:element name="SUBCHAPTER_ITEM" type="SubchapterItem"/>
          <!-- Page of the source book that gives the sheet. Free text: "38", "45-46". -->
      <xs:element name="Page" type="PlainString" minOccurs="0"/>
    </xs:sequence>
    <xs:attribute name="id" type="xs:string" use="required"/>
  </xs:complexType>

  <xs:complexType name="DataCareerType">
    <xs:sequence>
      <xs:element name="Career" type="CareerType" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <!-- ===================== DATA_ARMOR / DATA_ARMOR_SIMP / DATA_ARMOR_BONUS ===================== -->

  <!-- Price: minOccurs=0, some armour pieces "cannot be bought" (empty Price cell
       in the source book, e.g. NATIO-ARMO_CHAOS_BREASTPLATE Chaos Breastplate). -->
  <xs:complexType name="ArmorType">
    <xs:sequence>
      <xs:element name="Description" type="LangString"/>
      <xs:element name="Availability" type="PlainString"/>
      <xs:element name="Price" type="PlainString" minOccurs="0"/>
      <xs:element name="Encumbrance" type="PlainString"/>
      <xs:element name="Quality" type="PlainString"/>
      <xs:element name="Location" type="PlainString"/>
      <xs:element name="ArmorPoint" type="PlainString"/>
      <!-- Type: minOccurs=0, absent on WFRP5 shields (RULES-COMB_SHIELD_BUCKLER Buckler,
           BOOK_RULESBOOK.Xml WFRP5). -->
      <xs:element name="Type" type="PlainString" minOccurs="0"/>
      <xs:element name="InherentCraftsmanship" type="PlainString" minOccurs="0"/>
          <!-- Page of the source book that gives the sheet. Free text: "38", "45-46". -->
      <xs:element name="Page" type="PlainString" minOccurs="0"/>
    </xs:sequence>
    <xs:attribute name="id" type="xs:string" use="required"/>
  </xs:complexType>

  <xs:complexType name="DataArmorType">
    <xs:annotation>
      <xs:documentation xml:lang="en">ARMOURS: one Armor per piece. Location = zone(s) covered (RULES-ARMOL_HEAD, ARM, BODY, LEG; several separated by a comma), ArmorPoint = armour points, Quality = RULES-ARMOB_* codes of DATA_ARMOR_BONUS separated by commas, Type = material RULES-ARMOT_*, Availability = RULES-DISPO_*, Price = CO / PA / SB. Mandatory order: Description, Availability, Price, Encumbrance, Quality, Location, ArmorPoint, Type, InherentCraftsmanship, Page; Price, Type, InherentCraftsmanship and Page optional. See GABARIT_LIVRE_XML.md, section DATA_ARMOR.</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="Armor" type="ArmorType" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <!-- Real order checked on BOOK_RULESBOOK.Xml: Description, Availability, Price,
       Encumbrance, Quality, ArmorPoint. -->
  <xs:complexType name="ArmorSimpType">
    <xs:sequence>
      <xs:element name="Description" type="LangString"/>
      <xs:element name="Availability" type="PlainString"/>
      <xs:element name="Price" type="PlainString"/>
      <xs:element name="Encumbrance" type="PlainString"/>
      <xs:element name="Quality" type="PlainString"/>
      <xs:element name="ArmorPoint" type="PlainString"/>
    </xs:sequence>
    <xs:attribute name="id" type="xs:string" use="required"/>
  </xs:complexType>

  <xs:complexType name="DataArmorSimpType">
    <xs:annotation>
      <xs:documentation xml:lang="en">SIMPLIFIED ARMOURS of the optional Quick Armour rule (OptionRule with code QUICKARMOUR): one ArmorSimp = one complete set (Availability, Price, Encumbrance, Quality, ArmorPoint), without Location. Global setting (INI), not per book.</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="ArmorSimp" type="ArmorSimpType" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <!-- DATA_ARMOR_BONUS / DATA_WEAPON_BONUS share the BonusMalus wrapper -->
  <!-- Real order checked on BOOK_RULESBOOK.Xml: Description, Explanation, Modifier,
       then Corruption/Talent/ModifyCarac as options (position not confirmed, grouped
       as a free choice). -->
  <!-- Modifier is not always at the head of the optionals (Talent may precede it, see
       BOOK_ARCHIVES_OF_THE_EMPIRE_II.Xml): grouped with the other optionals. -->
  <xs:complexType name="ArmorBonusType">
    <xs:sequence>
      <xs:element name="Description" type="LangString"/>
      <xs:element name="Explanation" type="LangString"/>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:element name="Modifier" type="OptionallyNamedString"/>
        <xs:element name="NeedsValue" type="PlainString"/>
        <xs:element name="Corruption" type="PlainString"/>
        <xs:element name="Talent" type="PlainString"/>
        <xs:group ref="ModificateursEffets"/>
      </xs:choice>
          <!-- Page of the source book that gives the sheet. Free text: "38", "45-46". -->
      <xs:element name="Page" type="PlainString" minOccurs="0"/>
    </xs:sequence>
    <xs:attribute name="id" type="xs:string" use="required"/>
  </xs:complexType>

  <xs:complexType name="DataArmorBonusType">
    <xs:annotation>
      <xs:documentation xml:lang="en">ARMOUR QUALITIES AND FLAWS (catalogue cited by Quality of the DATA_ARMOR): BonusMalus id = RULES-ARMOB_*, Description = name, Explanation = text of the book, Modifier = effect as short free text. Optional numeric effects: ModifyCarac, ModifArmour... of the ModificateursEffets group. NeedsValue = 1 if the quality must receive a rating.</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="BonusMalus" type="ArmorBonusType" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <!-- ===================== DATA_WEAPON / DATA_WEAPON_BONUS ===================== -->

  <!--
    Description+Skill+Damage stay at the head throughout the checked corpus, but
    Availability/Reach/Price/Encumbrance/Quality/Hand/Ammunition turned out to be sometimes
    present, sometimes absent, in a variable order depending on the book (e.g. BOOK TRIBES AND
    TRIBULATIONS.Xml omits Availability and Price on its siege weapons). Documented relaxation
    (same logic as TalentType/TrappingType): Description/Skill/Damage fixed
    at the head, the rest in an unordered, repeatable xs:choice.
  -->
  <xs:complexType name="WeaponType">
    <xs:sequence>
      <xs:element name="Description" type="LangString"/>
      <xs:element name="Skill" type="PlainString" minOccurs="0"/>
      <xs:element name="Damage" type="PlainString"/>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:element name="Availability" type="PlainString"/>
        <xs:element name="Reach" type="PlainString"/>
        <xs:element name="Price" type="PlainString"/>
        <xs:element name="Encumbrance" type="PlainString"/>
        <xs:element name="Quality" type="PlainString"/>
        <xs:element name="Hand" type="PlainString"/>
        <xs:element name="Ammunition" type="PlainString"/>
        <xs:element name="Type" type="PlainString"/>
        <xs:element name="InherentCraftsmanship" type="PlainString"/>
        <xs:element name="Clan" type="PlainString"/>
        <!-- WFRP2 weapons only: Reload (e.g. "Half", "2 Full") and Note (book remarks and the qualities that are
             not one of the RULES-WEAPQ_* codes, e.g. "Other qualities: Size M/Lo"). Free text, not read by the game. -->
        <xs:element name="Reload" type="PlainString"/>
        <xs:element name="Note" type="PlainString"/>
        <!-- Numeric modifiers of the carried weapon (SourceModifArme). -->
        <xs:group ref="ModificateursEffets"/>
      </xs:choice>
          <!-- Page of the source book that gives the sheet. Free text: "38", "45-46". -->
      <xs:element name="Page" type="PlainString" minOccurs="0"/>
    </xs:sequence>
    <xs:attribute name="id" type="xs:string" use="required"/>
  </xs:complexType>

  <xs:complexType name="DataWeaponType">
    <xs:annotation>
      <xs:documentation xml:lang="en">WEAPONS AND AMMUNITION: one Weapon per weapon. Description, Skill (optional for the schema, given by all books: combat skill code; - = none) and Damage (formula, e.g. +(BATTR_S)+4) at the head, in that order; Page last; the rest optional and free: Reach (code RULES-WEAPR_* in melee, yards at range), Quality (RULES-WEAPB_* codes of DATA_WEAPON_BONUS, rating after a space: RULES-WEAPB_RELOAD 2), Hand (hands), Ammunition (0 = weapon; number of projectiles of the lot for an ammunition RULES-MUNI_*), Type (RULES-WTYPE_*), InherentCraftsmanship (craftsmanship already built in). See GABARIT_LIVRE_XML.md, section DATA_WEAPON.</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="Weapon" type="WeaponType" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <!-- Real order checked on BOOK_RULESBOOK.Xml: Description, Explanation, Short, Modifier. -->
  <xs:complexType name="WeaponBonusType">
    <xs:sequence>
      <xs:element name="Description" type="LangString"/>
      <xs:element name="Explanation" type="LangString"/>
      <xs:element name="Short" type="LangString"/>
      <!-- Effect of the quality as data: Accurate, Reload, Salvo; Shield = ModifArmour on the location RULES-ARMOL_SHIELD. -->
      <!-- The whole ModificateursEffets group (ModifyCarac, ModifyDamage...) replaces the four isolated tags: a CARRIED weapon quality modifies the bearer (Might +30 S, Protection +1 AP). -->
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:group ref="ModificateursEffets"/>
        <!-- Mandatory value: "1" = a weapon that cites this quality must give a rating (Reload 3, Salvo 1d10). -->
        <xs:element name="NeedsValue" type="PlainString"/>
        <!-- Talent granted to the bearer of the weapon (ListArmeBonusTalent, like the craftsmanship Of Rigor Wroth). -->
        <xs:element name="Talent" type="PlainString"/>
        <!-- Weapon qualities granted by this quality (codes separated by commas, e.g. Parry = Balanced + Defensive); displayed in the Qualities column of the CARRIED weapon (FabricationQualitesArme). -->
        <xs:element name="WeaponQuality" type="PlainString"/>
      </xs:choice>
      <xs:element name="Modifier" type="PlainString"/>
          <!-- Page of the source book that gives the sheet. Free text: "38", "45-46". -->
      <xs:element name="Page" type="PlainString" minOccurs="0"/>
    </xs:sequence>
    <xs:attribute name="id" type="xs:string" use="required"/>
  </xs:complexType>

  <xs:complexType name="DataWeaponBonusType">
    <xs:annotation>
      <xs:documentation xml:lang="en">WEAPON QUALITIES AND FLAWS (catalogue cited by Quality of the DATA_WEAPON): BonusMalus id = RULES-WEAPB_*, Description, Explanation, Short (one-line summary for lists and the PDF), mandatory Modifier: + = quality, - = flaw. NeedsValue = 1 if the weapon must give a rating. WeaponQuality = other qualities granted, Talent = talent granted to the bearer, plus the numeric effects of the ModificateursEffets group.</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="BonusMalus" type="WeaponBonusType" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <!-- ===================== DATA_CRAFTMANSHIP ===================== -->
  <!--
    Catch-all block depending on the type of item concerned: all the optionals stay
    minOccurs=0, the real observed order is kept but xs:choice/maxOccurs=unbounded
    is used so as not to freeze a precise combination (none accumulates all the tags).
  -->
  <!-- Real order checked on BOOK UNOFFICIAL GRIMOIRE.Xml: Description, Explanation, Short,
       then a variable choice depending on the type of item concerned (Applies/WeaponQuality/Max/
       Modifier/etc, no fixed position), grouped as a repeatable xs:choice. -->
  <xs:complexType name="CraftsmanshipType">
    <xs:sequence>
      <xs:element name="Description" type="LangString"/>
      <xs:element name="Explanation" type="LangString" minOccurs="0"/>
      <xs:element name="Short" type="LangString"/>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:element name="Applies" type="PlainString"/>
        <xs:element name="WeaponQuality" type="PlainString"/>
        <xs:group ref="ModificateursEffets"/>
        <xs:element name="Encumbrance" type="PlainString"/>
        <xs:element name="Talent" type="PlainString"/>
        <xs:element name="RangeBonus" type="PlainString"/>
        <xs:element name="AlternateWeapon" type="PlainString"/>
        <xs:element name="Max" type="PlainString"/>
        <xs:element name="Modifier" type="PlainString"/>
      </xs:choice>
          <!-- Page of the source book that gives the sheet. Free text: "38", "45-46". -->
      <xs:element name="Page" type="PlainString" minOccurs="0"/>
    </xs:sequence>
    <xs:attribute name="id" type="xs:string" use="required"/>
  </xs:complexType>

  <xs:complexType name="DataCraftmanshipType">
    <xs:annotation>
      <xs:documentation xml:lang="en">CRAFTSMANSHIPS (item qualities, runes, enchantments) chosen in the Craftsmanship column of the equipment: Description, Explanation (optional), Short, then as desired Applies (Weapon, Armour or Misc, filters the list; absent = any item), Max (maximum number on one item), Modifier (BONUS, PRACTICAL, UNRELIABLE, BULKY or empty: nature of the craftsmanship), Encumbrance, RangeBonus, WeaponQuality, AlternateWeapon, Talent and the numeric effects of the ModificateursEffets group (value without quotation marks, sign included: +10; a conditional effect carries if=: code of DATA_CONDITION, display only).</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="Craftsmanship" type="CraftsmanshipType" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <!-- ===================== DATA_SKILL / DATA_SKILL_SPECIALIZATION ===================== -->
  <!--
    Mandatory: Skill[id], Attribut, Description. Almost mandatory: Explanation.
    IMPORTANT (same safeguard as DATA_TALENT): <Generique> was found in
    BOOK UNOFFICIAL GRIMOIRE.Xml (GRIM-COMPFOCAL_WILD, GRIM-COMPSAVOIR_WOOD/FAITH/NATURE):
    4 specialisation skills (Channelling/Lore of a specific domain) entered by mistake
    in DATA_SKILL instead of DATA_SKILL_SPECIALIZATION, exactly the same bug as the one
    fixed on DATA_TALENT. <Generique> is therefore FORBIDDEN here too (the entries
    concerned must be corrected in the book).
  -->
  <xs:complexType name="SkillType">
    <xs:sequence>
      <xs:element name="Attribut" type="PlainString"/>
      <xs:element name="FreeSpecialisation" type="PlainString" minOccurs="0">
        <xs:annotation>
          <xs:documentation xml:lang="en">"1" = the player may create a specialisation that is not in the book (+Specialisation button): Art, Trade, Language, Lore... Absent = refused (weapon-linked combat skills, closed lists). On the GENERIC entry only.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="Description" type="LangString"/>
      <xs:element name="Explanation" type="LangString" minOccurs="0"/>
      <xs:element name="Basic" type="PlainString" minOccurs="0"/>
          <!-- Page of the source book that gives the sheet. Free text: "38", "45-46". -->
      <xs:element name="Page" type="PlainString" minOccurs="0"/>
    </xs:sequence>
    <xs:attribute name="id" type="xs:string" use="required"/>
  </xs:complexType>

  <xs:complexType name="DataSkillType">
    <xs:sequence>
      <xs:element name="Skill" type="SkillType" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <!-- Mandatory: Skill[id], Description. Generique almost everywhere (minOccurs=0 because one
       case of the corpus lacks it, open point). -->
  <xs:complexType name="SkillSpecializationType">
      <xs:annotation>
        <xs:documentation xml:lang="en">SPECIALISATION of a generic skill (Lore (Parravon), Language (Strigany)). Generique = code of the parent skill with _* ("RULES-COMPSAVOIR_*"); id = &lt;parent prefix&gt;-COMP&lt;PARENT&gt;_&lt;SUFFIX&gt;: a specialisation of a Rulebook skill keeps the RULES- prefix even in the file of another book. NEVER in DATA_SKILL (it would be an independent skill). Page = page of the source book.</xs:documentation>
      </xs:annotation>
    <xs:sequence>
      <xs:element name="Description" type="LangString"/>
      <xs:element name="Generique" type="PlainString" minOccurs="0"/>
      <!-- Attribut specific to the specialisation, only if it differs from the parent's
           (e.g. Trade (Cook) = Int in V2: Trade (Various) has no attribute). -->
      <xs:element name="Attribut" type="PlainString" minOccurs="0"/>
      <xs:element name="Basic" type="PlainString" minOccurs="0"/>
          <!-- Page of the source book that gives the sheet. Free text: "38", "45-46". -->
      <xs:element name="Page" type="PlainString" minOccurs="0"/>
    </xs:sequence>
    <xs:attribute name="id" type="xs:string" use="required"/>
  </xs:complexType>

  <xs:complexType name="DataSkillSpecializationType">
    <xs:sequence>
      <xs:element name="Skill" type="SkillSpecializationType" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <!-- ===================== DATA_SKILL_COST / DATA_ATTRIBUT_COST ===================== -->
  <!-- Table indexed by position, no id on the wrapper. Checked on BOOK_RULESBOOK.Xml. -->
  <xs:complexType name="DataCostType">
    <xs:sequence>
      <xs:element name="Cost" type="NamedString" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <!-- ===================== DATA_ATTRIBUT ===================== -->
  <!-- Real order checked on BOOK_RULESBOOK.Xml: Description, Explanation, Short, Order. -->
  <xs:complexType name="AttributType">
    <xs:sequence>
      <xs:element name="Description" type="LangString"/>
      <xs:element name="Explanation" type="LangString"/>
      <xs:element name="Short" type="LangString"/>
      <xs:element name="Order" type="PlainString"/>
      <xs:element name="Page" type="PlainString" minOccurs="0"/>
    </xs:sequence>
    <xs:attribute name="id" type="xs:string" use="required"/>
  </xs:complexType>

  <xs:complexType name="DataAttributType">
    <xs:sequence>
      <xs:element name="Attribut" type="AttributType" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <!-- ===================== DATA_SPECIE ===================== -->
  <!--
    Mandatory: Specie[id], Talent, SUBCHAPTER_TALENT, Description, SUBCHAPTER_SKILL,
    Ethnic, SUBCHAPTER_ATTR, Attribut, Skill.
    Almost mandatory: Explanation, SUBCHAPTER_CAREER+Career.
    Very variable optionals (see list below), kept minOccurs=0 including for
    WFRP5 (simplest structure, base Human, without SUBCHAPTER_PHYSICAL in the only
    known sample, but fields kept optional for a future V5 book).
  -->
  <xs:complexType name="SubchapterCareer">
    <xs:sequence>
      <xs:element name="Career" type="NamedString" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <!-- Real order checked on BOOK_RULESBOOK.Xml: Age, Height, HeightExplode, EyeRolls,
       Eye[name]* (roll table), Hair[name]* (same), NamePattern sometimes in addition:
       grouped as a repeatable free choice, the Eye/Hair table having a variable number of lines. -->
  <xs:complexType name="SubchapterPhysical">
    <xs:sequence>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:element name="Age" type="PlainString"/>
        <xs:element name="Height" type="PlainString"/>
        <xs:element name="HeightExplode" type="PlainString"/>
        <xs:element name="EyeRolls" type="PlainString"/>
        <xs:element name="Eye" type="NamedString"/>
        <xs:element name="Hair" type="NamedString"/>
        <xs:element name="NamePattern" type="PlainString"/>
        <!-- V2 (Core, tables 2-6 to 2-17): height per sex in inches ("50+1d10"), then d100 / d10 tables:
             Weight name=pounds, AgeRoll name=years, Siblings name=number, Birthplace name=place,
             BirthplaceSettlement name=type of place (human), content = die range. BirthplaceHuman = range
             that refers to the human birth roll. -->
        <xs:element name="HeightFemale" type="PlainString"/>
        <xs:element name="HeightMale" type="PlainString"/>
        <xs:element name="Weight" type="NamedString"/>
        <xs:element name="AgeRoll" type="NamedString"/>
        <xs:element name="Siblings" type="NamedString"/>
        <xs:element name="Birthplace" type="NamedString"/>
        <xs:element name="BirthplaceSettlement" type="NamedString"/>
        <xs:element name="BirthplaceHuman" type="PlainString"/>
        <!-- Effects of a birthplace (Skaven clan, Children of the Horned Rat): name = same name as
             the Birthplace line, content = list "Skill:CODE;Talent:CODE;Item:CODE" separated by
             semicolons. -->
        <xs:element name="BirthplaceEffect" type="NamedString"/>
        <!-- Effects of a particular shape (familiars, Realms of Sorcery tables 7-1 and 7-2): name = line of
             the table, content = list "Talent:CODE[=N];Natural:CODE;Grapple:N" (Natural = natural weapon always
             carried, Grapple = grapple bonus in percent, displayed only). -->
        <xs:element name="OddityEffect" type="NamedString"/>
        <!-- Familiars (Realms of Sorcery): rollable tables, name = line, content = d100 range:
             Form = table 7-1 (form), FormAnimal = 7-3 (animal), Oddity = 7-2 (oddities). -->
        <xs:element name="Form" type="NamedString"/>
        <xs:element name="FormAnimal" type="NamedString"/>
        <xs:element name="Oddity" type="NamedString"/>
      </xs:choice>
    </xs:sequence>
  </xs:complexType>

  <!-- Checked on BOOK_SEA_OF_CLAWS.Xml and BOOK_RULESBOOK.Xml: NamePattern carries either
       sex="M"/"F", or rule="CODE" (name rule declared by NameRule, e.g. NOBLE = "von_"+place): the two attributes are therefore
       optional here (at least one of the two is presumed present, not verifiable in XSD 1.0
       without an assertion). Name always carries part+name; sex absent for part="Surname". -->
  <xs:complexType name="NamePatternType">
    <xs:simpleContent>
      <xs:extension base="xs:string">
        <xs:attribute name="sex" type="xs:string" use="optional"/>
        <xs:attribute name="rule" type="xs:string" use="optional"/>
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>

  <xs:complexType name="NameEntryType">
    <xs:simpleContent>
      <xs:extension base="xs:string">
        <xs:attribute name="part" type="xs:string" use="required"/>
        <xs:attribute name="sex" type="xs:string" use="optional"/>
        <xs:attribute name="name" type="xs:string" use="required"/>
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>

  <!-- NameRule: name rule offered to the player at creation; code= links the NamePattern
       rule="CODE", the content is a label id (INTERFACE) or a text. -->
  <xs:complexType name="NameRuleType">
    <xs:simpleContent>
      <xs:extension base="xs:string">
        <xs:attribute name="code" type="xs:string" use="required"/>
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>

  <xs:complexType name="SubchapterNames">
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:element name="NameRule" type="NameRuleType"/>
      <xs:element name="NamePattern" type="NamePatternType"/>
      <xs:element name="Name" type="NameEntryType"/>
    </xs:choice>
  </xs:complexType>

  <!-- DATA_SPECIE uses Skill/Talent WITHOUT a name attribute in SUBCHAPTER_SKILL/
       SUBCHAPTER_TALENT (unlike DATA_CAREER, which uses name=...): dedicated types. -->
  <xs:complexType name="SubchapterSkillPlain">
    <xs:sequence>
      <xs:element name="Skill" type="PlainString" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="SubchapterTalentPlain">
    <xs:sequence>
      <xs:element name="Talent" type="PlainString" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <!-- <OPINIONS><Opinion target="..." source="...">texte</Opinion>...</OPINIONS> -->
  <xs:complexType name="OpinionType">
    <xs:simpleContent>
      <xs:extension base="xs:string">
        <xs:attribute name="target" type="xs:string" use="required"/>
        <xs:attribute name="source" type="xs:string" use="required"/>
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>

  <xs:complexType name="OpinionsType">
    <xs:sequence>
      <xs:element name="Opinion" type="OpinionType" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <!--
    Description is always at the head (checked on the whole WFRP4+WFRP5 corpus), but ALL
    the rest (Explanation, OPINIONS, Ethnic, Nationality, SUBCHAPTER_ATTR,
    SUBCHAPTER_PHYSICAL, SUBCHAPTER_TALENT/Talent, SUBCHAPTER_SKILL/Skill,
    SUBCHAPTER_CAREER, SUBCHAPTER_NAMES, Skill5/Skill3, Rule, PictureLevel) turned out to be
    in a DIFFERENT order from one book to another, including between the ENGLISH and
    FRANCAIS versions of the SAME book (BOOK_RULESBOOK.Xml vs BOOK_RULESBOOK_FRANCAIS.Xml: the
    FR version has SUBCHAPTER_PHYSICAL before Ethnic, the EN version has it after SUBCHAPTER_ATTR).
    Documented relaxation (same logic as TalentType): Description fixed at the head, the
    rest in an unordered, repeatable xs:choice. This is the most permissive structure of this
    schema, but it remains a strict whitelist of tags (no tag foreign to
    DATA_SPECIE is accepted).
  -->
  <xs:complexType name="SpecieType">
      <xs:annotation>
        <xs:documentation xml:lang="en">ETHNICITY (not a race). VOCABULARY TRAP: the tags say the opposite of the identifiers. DATA_SPECIE carries the ETHNICITIES (id RULES-RACE_HUM = 'Humans (Reikland)'); its Ethnic field goes up to the RACE (RULES-SPECIE_HUMAN); DATA_RACE carries the races. Model: one race, N ethnicities. Content: Description; Explanation; Ethnic = race code; SUBCHAPTER_ATTR = profile, one line per characteristic, value = die formula ("2d10+20"), constant ("2" for Fate) or sum of bonuses ("1xBATTR_S+2xBATTR_T+1xBATTR_WP" for Wounds); SUBCHAPTER_SKILL / SUBCHAPTER_TALENT = starting skills and talents (WITHOUT a name attribute: the code is the content). A code can be "A/B" (a choice), "RULES-COMPCHEV_*" (a specialisation to choose at creation), "RULES-T*" (random talent, one line per roll); SUBCHAPTER_CAREER = career table: Career name = career code, value = WEIGHT in the d100 (an integer; the bounds are deduced), "X" = eligible outside the roll, "-" = cannot be rolled. The weights of an ethnicity total 100. Nationality = code of a nation (DATA_NATION). XML comments between two lines: tolerated, see the guide. A 'stub' (ethnicity reduced to SUBCHAPTER_CAREER) adds careers to an ethnicity of ANOTHER book.</xs:documentation>
      </xs:annotation>
    <xs:sequence>
      <!-- Description: minOccurs=0 ONLY for the documented "stubs" (e.g.:
           BOOK_NATIONS_OF_MANKIND.Xml, Specie id="SEAOF-RACE_HBJOR" reduced to
           SUBCHAPTER_CAREER): a career attached to a race defined by ANOTHER
           book, without redeclaring Description/SUBCHAPTER_ATTR/etc. For every other entry,
           Description must stay present (to be checked manually, the XSD cannot
           tell a legitimate stub from an omission). -->
      <xs:element name="Description" type="LangString" minOccurs="0"/>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:element name="Explanation" type="LangString"/>
        <xs:element name="Ethnic" type="PlainString"/>
        <xs:element name="Nationality" type="PlainString"/>
        <!-- V2: "Oui" = the ethnicity receives a starting mutation (Mutant, Tome of Corruption p.25); triggers phase 2.2 of WinCreation. -->
        <xs:element name="StartingMutation" type="PlainString"/>
        <!-- Specific to V2: Background and RoleplayingHints = texts of the book; Wounds and FatePoints = d10 tables by range ("1-3: 11; 4-6: 12; ..."), tables 2-2 and 2-3 of the Core. -->
        <xs:element name="Background" type="PlainString"/>
        <xs:element name="RoleplayingHints" type="PlainString"/>
        <xs:element name="Wounds" type="PlainString"/>
        <xs:element name="FatePoints" type="PlainString"/>
        <xs:element name="SUBCHAPTER_ATTR" type="SubchapterAttr"/>
        <xs:element name="Talent" type="PlainString"/>
        <xs:element name="SUBCHAPTER_TALENT" type="SubchapterTalentPlain"/>
        <xs:element name="Skill" type="PlainString"/>
        <xs:element name="SUBCHAPTER_SKILL" type="SubchapterSkillPlain"/>
        <xs:element name="SUBCHAPTER_CAREER" type="SubchapterCareer"/>
        <xs:element name="SUBCHAPTER_NAMES" type="SubchapterNames"/>
        <xs:element name="Skill5" type="PlainString"/>
        <xs:element name="Skill3" type="PlainString"/>
        <!-- WFRP5: skill the species grants outright, no choice (starting languages, e.g. Reikspiel "30" = six Advances). name = skill code, content = points. -->
        <xs:element name="FixedSkill" type="NamedString"/>
        <xs:element name="Rule" type="PlainString"/>
        <xs:element name="PictureLevel" type="PlainString"/>
      </xs:choice>
          <!-- Page of the source book that gives the sheet. Free text: "38", "45-46". -->
      <xs:element name="Page" type="PlainString" minOccurs="0"/>
    </xs:sequence>
    <xs:attribute name="id" type="xs:string" use="required"/>
  </xs:complexType>

  <xs:complexType name="DataSpecieType">
    <xs:sequence>
      <xs:element name="Specie" type="SpecieType" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <!-- ===================== DATA_RACE ===================== -->
  <!-- Minimal, stable structure, identical WFRP4/WFRP5. DO NOT CONFUSE with DATA_SPECIE. -->
  <xs:complexType name="RaceType">
      <xs:annotation>
        <xs:documentation xml:lang="en">RACE (not an ethnicity): Description, OPINIONS, SUBCHAPTER_PHYSICAL (age, height, eyes, hair, rolled for all its ethnicities). The ethnicities are DATA_SPECIE entries whose Ethnic field points at this id (RULES-SPECIE_HUMAN, RULES-SPECIE_DWARF...). See the vocabulary inversion explained on SpecieType.</xs:documentation>
      </xs:annotation>
    <xs:sequence>
      <xs:element name="Description" type="LangString"/>
      <!-- Opinions of this race about the others: target = code of a RACE (not an ethnicity), a single
           source per race. -->
      <xs:element name="OPINIONS" type="OpinionsType" minOccurs="0"/>
      <!-- Physical details of the race (age, height, eyes, hair): carried by the race, not by an ethnicity.
           The ethnicities of a race without a block of its own have none: they roll those of their race. -->
      <xs:element name="SUBCHAPTER_PHYSICAL" type="SubchapterPhysical" minOccurs="0"/>
          <!-- Page of the source book that gives the sheet. Free text: "38", "45-46". -->
      <xs:element name="Page" type="PlainString" minOccurs="0"/>
    </xs:sequence>
    <xs:attribute name="id" type="xs:string" use="required"/>
  </xs:complexType>

  <xs:complexType name="DataRaceType">
    <xs:sequence>
      <xs:element name="Race" type="RaceType" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <!-- ===================== DATA_PERSONAL_TABLE (V2) ===================== -->
  <!-- Personal-detail tables common to all races (Core V2: distinguishing marks 2-10, star sign 2-12).
       Entry name = result, detail = meaning (star sign), content = d100 range ("01-05"). -->
  <xs:complexType name="PersonalEntryType">
    <xs:simpleContent>
      <xs:extension base="xs:string">
        <xs:attribute name="name" type="xs:string" use="required"/>
        <xs:attribute name="detail" type="xs:string" use="optional"/>
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>
  <xs:complexType name="PersonalTableType">
    <xs:sequence>
      <xs:element name="Entry" type="PersonalEntryType" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:attribute name="id" type="xs:string" use="required"/>
  </xs:complexType>
  <xs:complexType name="DataPersonalTableType">
    <xs:sequence>
      <xs:element name="Table" type="PersonalTableType" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <!-- ===================== DATA_RANDOM_SPECIE ===================== -->
  <xs:complexType name="DataRandomSpecieType">
      <xs:annotation>
        <xs:documentation xml:lang="en">D100 TABLE OF THE RANDOM RACE: Specie name = race code, value = range ("01-89", "98"); the ranges cover 01-100 without overlap.</xs:documentation>
      </xs:annotation>
    <xs:sequence>
      <xs:element name="Specie" type="NamedString" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <!-- ===================== DATA_RANDOM_TALENT ===================== -->
  <!--
    Structure verified as really nested: the wrapper <DATA_RANDOM_TALENT> contains
    N elements <DATA_RANDOM_TALENT id="..."> (SAME TAG NAME repeated, each with
    Specie+Talent). Confirmed on BOOK_GREEN_IZ_BEST.Xml and BOOK_RULESBOOK.Xml:
    it is not a false positive of the earlier audit, it is the real structure and
    consistent across the corpus (the initial report of a suspect nesting is therefore
    closed, not an open point).
  -->
  <xs:complexType name="RandomTalentEntryType">
    <xs:sequence>
      <xs:element name="Specie" type="PlainString"/>
      <xs:element name="Talent" type="NamedString"/>
    </xs:sequence>
    <xs:attribute name="id" type="xs:string" use="required"/>
  </xs:complexType>

  <xs:complexType name="DataRandomTalentType">
      <xs:annotation>
        <xs:documentation xml:lang="en">TABLE OF THE RANDOM TALENTS OF AN ETHNICITY. The wrapper AND the entries carry the same tag name: DATA_RANDOM_TALENT contains DATA_RANDOM_TALENT id="..." (intended, not an error). One entry = one talent (id = code, e.g. RULES-T_ACUTE_SENSE__*) x one ethnicity (Specie); the value of Talent name is the weight in the d100; the sum of the weights of an ethnicity is 0 or 100.</xs:documentation>
      </xs:annotation>
    <xs:sequence>
      <xs:element name="DATA_RANDOM_TALENT" type="RandomTalentEntryType" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <!-- ===================== DATA_NATION ===================== -->
  <xs:complexType name="NationType">
    <xs:sequence>
      <xs:element name="Description" type="LangString"/>
          <!-- Page of the source book that gives the sheet. Free text: "38", "45-46". -->
      <xs:element name="Page" type="PlainString" minOccurs="0"/>
    </xs:sequence>
    <xs:attribute name="id" type="xs:string" use="required"/>
  </xs:complexType>

  <xs:complexType name="DataNationType">
    <xs:sequence>
      <xs:element name="Nation" type="NationType" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <!-- ===================== DATA_TRAPPING ===================== -->
  <!--
    Mandatory: Trapping[id], Theme, Description.
    Almost mandatory: Encumbrance, Price, Availability.
    Optional depending on sub-type (mounts, vehicles, merchants...), grouped in a repeatable
    xs:choice so as not to freeze a single order between very different sub-types.
    Theme = reference to a code RULES-LAB_nnn (label), not a literal enum: xs:string.
  -->
  <!--
    Order and presence of Availability/Price/Encumbrance/Carries/etc. turned out to vary
    from one book to another (Description/Theme always at the head, checked on 6+ books, but the
    rest diverges: e.g. BOOK ENEMY IN SHADOWS COMPANION.Xml has Price before Availability without
    Encumbrance, BOOK_SEA_OF_CLAWS.Xml has Availability before Price with Encumbrance always
    present). Documented relaxation (same logic as TalentType): Description+Theme
    fixed at the head, the rest in an unordered, repeatable xs:choice.
  -->
  <xs:complexType name="TrappingType">
      <xs:annotation>
        <xs:documentation xml:lang="en">MISCELLANEOUS ITEM (equipment that is neither weapon nor armour). id = &lt;BOOK&gt;-TRAP_nnn. Theme = category, a label CODE: RULES-LAB_190 Containers, 191 Clothing and Accessories, 192 Food Drink and Lodging, 193 Tools and Kits, 194 Books and Documents, 195 Animals and Vehicles, 196 Miscellaneous, 197 Drugs and Poisons, 198 Herbs and Draughts, 199 Prosthetics and Curiosities, 260 Mounts and animals. Availability = RULES-DISPO_COMMON / _LIMITED / _RARE / _EXOTIC / _UNIQUE. Price = concatenated amounts, units CO (gold crown), PA (silver pistole), SB (bronze bit): "3CO", "4PA 2SB"; free text tolerated ("Varies"). Encumbrance = integer ("0" = no encumbrance). Absent from the book = absent from the XML: an item that the book does not price has neither Price nor Availability. The fields of mounts (AnimalProfile, AnimalTraits, Carries) and boats (BoatProfile, ModifBoat) are reserved for those sub-types.</xs:documentation>
      </xs:annotation>
    <xs:sequence>
      <xs:element name="Description" type="LangString"/>
      <!-- Theme: minOccurs=0, absent on some WFRP5 items (Buckler/Shield/Backpack
           in BOOK_RULESBOOK.Xml WFRP5). -->
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:element name="Theme" type="PlainString"/>
        <xs:element name="Availability" type="PlainString"/>
        <xs:element name="Price" type="PlainString"/>
        <xs:element name="Encumbrance" type="PlainString"/>
        <xs:element name="Carries" type="PlainString"/>
        <xs:element name="AnimalTraits" type="PlainString"/>
        <xs:element name="BoatProfile" type="PlainString"/>
        <xs:element name="AnimalProfile" type="PlainString"/>
        <xs:element name="VehicleProfile" type="PlainString"/>
        <xs:element name="ModifBoat" type="NamedString"/>
        <xs:element name="Buyer" type="PlainString"/>
        <xs:element name="Season" type="PlainString"/>
        <xs:element name="Locality" type="PlainString"/>
        <xs:element name="InherentCraftsmanship" type="PlainString"/>
      </xs:choice>
          <!-- Page of the source book that gives the sheet. Free text: "38", "45-46". -->
      <xs:element name="Page" type="PlainString" minOccurs="0"/>
    </xs:sequence>
    <xs:attribute name="id" type="xs:string" use="required"/>
  </xs:complexType>

  <xs:complexType name="DataTrappingType">
    <xs:sequence>
      <xs:element name="Trapping" type="TrappingType" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <!-- ===================== DATA_LABEL ===================== -->
  <xs:complexType name="LabelTextType">
    <xs:simpleContent>
      <xs:extension base="xs:string">
        <xs:attribute name="name" type="xs:string" use="required"/>
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>

  <xs:complexType name="LabelType">
    <xs:sequence>
      <xs:element name="Text" type="LabelTextType" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:attribute name="language" type="xs:string" use="required"/>
  </xs:complexType>

  <xs:complexType name="DataLabelType">
    <xs:sequence>
      <xs:element name="Label" type="LabelType" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <!-- Career roll rules (DATA_RULE, DATA_CAREER_ROLL): moved from SCHEMA_WFRP4.xsd,
       shared with V2 (master table of the Career Compendium). -->
  <!-- DATA_CAREER_ROLL: repeated Entry, no id on the wrapper. -->
  <xs:complexType name="CareerRollEntryType">
    <xs:sequence>
      <xs:element name="Rule" type="PlainString"/>
      <xs:element name="Specie" type="PlainString"/>
      <xs:element name="Career" type="NamedString"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="DataCareerRollType">
      <xs:annotation>
        <xs:documentation xml:lang="en">D100 CAREER ROLL TABLE FOR A RULE (not for an ethnicity). One Entry = one career in the column of an ethnicity or race: Rule = code of a rule (DATA_RULE) that REPLACES the base table, Specie = ethnicity OR race (a race applies to all its ethnicities), Career name = career; the value is a CHANCE: an integer = weight (number of d100 values occupied, the bounds 01-03 etc. are deduced by sorting the careers by class then by label), "X" = eligible but outside the roll. No id on the wrapper. The ranges are never entered: see ChargeTirageMetier.pas. XML comment between two Entry: tolerated.</xs:documentation>
      </xs:annotation>
    <xs:sequence>
      <xs:element name="Entry" type="CareerRollEntryType" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <!-- DATA_RULE -->
  <xs:complexType name="RuleType">
    <xs:sequence>
      <xs:element name="Description" type="LangString"/>
      <!-- What the rule implies for creation: text shown to the player in the optional-rules window, so that
           they tick or untick it knowingly. Translatable. -->
      <xs:element name="Explanation" type="LangString" minOccurs="0"/>
      <!-- Base class replaced by a PARTIAL rule (Seafarer); absent = total rule -->
      <xs:element name="Class" type="xs:string" minOccurs="0"/>
      <!-- Chance (in percent, 1 to 99) of starting the game with a mutation: creation offers a d100 roll
           after the career (Races and Regional Options, Special lines). -->
      <xs:element name="StartingMutation" type="PlainString" minOccurs="0"/>
          <!-- Page of the source book that gives the sheet. Free text: "38", "45-46". -->
      <xs:element name="Page" type="PlainString" minOccurs="0"/>
    </xs:sequence>
    <xs:attribute name="id" type="xs:string" use="required"/>
  </xs:complexType>

  <xs:complexType name="DataRuleType">
    <xs:annotation>
      <xs:documentation xml:lang="en">BOOK RULES: a Rule is a label (id, Description, optional Explanation shown to the player in the rules window) cited by the roll blocks DATA_CAREER_ROLL, DATA_RULE_SPECIE, DATA_RULE_BACKGROUND, DATA_RULE_SKILL_ROLL, DATA_RULE_TALENT_ROLL. Class = class replaced by a partial rule; StartingMutation = percent chance of starting with a mutation. Not to be confused with DATA_OPTION_RULE, which wires an engine switch.</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="Rule" type="RuleType" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <!-- DATA_RULE_SPECIE: skills and talents that a rule (DATA_RULE) gives to an
       ethnicity IN REPLACEMENT of its own. One Entry = one skill OR one talent. Specie = ethnicity or
       race (the ethnicity takes precedence). If a rule carries at least one Skill for the ethnicity, it replaces the whole
       skill block of the ethnicity; same for Talent. A value may be "A/B" (a choice) or
       "RULES-T*", as in SUBCHAPTER_SKILL / SUBCHAPTER_TALENT. Case: regional variants of
       Realm of the Ice Queen. No id on the wrapper. -->
  <xs:complexType name="RuleSpecieEntryType">
    <xs:sequence>
      <xs:element name="Rule" type="PlainString"/>
      <xs:element name="Specie" type="PlainString"/>
      <xs:choice>
        <xs:element name="Skill" type="PlainString"/>
        <xs:element name="Talent" type="PlainString"/>
      </xs:choice>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="DataRuleSpecieType">
    <xs:sequence>
      <xs:element name="Entry" type="RuleSpecieEntryType" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <!-- DATA_RULE_BACKGROUND: table that ROLLS the background (a DATA_RULE) of an ethnicity or
       race. One Entry = one ethnicity (Specie) x one rule (Rule name = code of the background rule,
       value = weight in the d100); the sum of the weights of an ethnicity is 100. Same principle as
       DATA_CAREER_ROLL (weights, no ranges): a multiple of 10 of elves/dwarfs that refers to another
       background is written with weights, not with a special case. Case: Liber Fanatica
       (Character Backgrounds). No id on the wrapper. -->
  <xs:complexType name="RuleBackgroundEntryType">
    <xs:sequence>
      <xs:element name="Specie" type="PlainString"/>
      <xs:element name="Rule" type="NamedString"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="DataRuleBackgroundType">
    <xs:sequence>
      <xs:element name="Entry" type="RuleBackgroundEntryType" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <!-- DATA_RULE_BACKGROUND_COUNT: the d10 that gives the number of skills and talents of the
       background. Weight = number of d10 faces covered by the entry (the sum is 10). An Entry without
       Skills or Talents = a result that asks for a SECOND background (Liber Fanatica: 10). -->
  <xs:complexType name="RuleBackgroundCountEntryType">
    <xs:sequence>
      <xs:element name="Weight" type="PlainString"/>
      <xs:element name="Skills" type="PlainString" minOccurs="0"/>
      <xs:element name="Talents" type="PlainString" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="DataRuleBackgroundCountType">
    <xs:sequence>
      <xs:element name="Entry" type="RuleBackgroundCountEntryType" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <!-- DATA_RULE_SKILL_ROLL / DATA_RULE_TALENT_ROLL: d100 table of the skills (or talents)
       of a background. Entry = Rule (the background) + Skill (or Talent) name=<code> value=<weight>; generic
       code "..._*" = the player chooses the specialisation. Same weight principle as DATA_CAREER_ROLL. -->
  <xs:complexType name="RuleSkillRollEntryType">
    <xs:sequence>
      <xs:element name="Rule" type="PlainString"/>
      <xs:element name="Skill" type="NamedString"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="DataRuleSkillRollType">
    <xs:sequence>
      <xs:element name="Entry" type="RuleSkillRollEntryType" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="RuleTalentRollEntryType">
    <xs:sequence>
      <xs:element name="Rule" type="PlainString"/>
      <xs:element name="Talent" type="NamedString"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="DataRuleTalentRollType">
    <xs:sequence>
      <xs:element name="Entry" type="RuleTalentRollEntryType" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>


  <!-- DATA_CAREER_BONUS: moved from SCHEMA_WFRP4.xsd, shared with V2 (cults of the Initiate).
       Empty Specie = no condition of origin. -->
  <!--
    DATA_CAREER_BONUS (1 sample): Level carries an id of its own (e.g. "..._1"), variable
    content (Order + free choice among SkillChoice/SpecialRule/ModifySkill/ModifyCarac/
    Skill/ModifyWeapon). Same note of caution as DATA_CAREER_ADAPTATION.
  -->
  <xs:complexType name="CareerBonusLevelType">
    <xs:sequence>
      <xs:element name="Order" type="PlainString"/>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:element name="SkillChoice" type="SkillChoiceType"/>
        <xs:element name="SpecialRule" type="OptionallyNamedString"/>
        <xs:element name="ModifySkill" type="xs:anyType"/>
        <xs:group ref="ModificateursEffets"/>
        <xs:element name="Skill" type="xs:anyType"/>
        <xs:element name="Talent" type="xs:anyType"/>
        <!-- Talents the membership only lets the character LEARN (purchase menu, comma-separated
             like Talent). Not printed as possessed on the V2 sheet; Talent stays a gain. -->
        <xs:element name="TalentLearnable" type="xs:anyType"/>
      </xs:choice>
    </xs:sequence>
    <xs:attribute name="id" type="xs:string" use="required"/>
  </xs:complexType>

  <!-- <SkillChoice Count="3" Value="5"/> (empty element, attributes only). -->
  <xs:complexType name="SkillChoiceType">
    <xs:attribute name="Count" type="xs:string" use="optional"/>
    <xs:attribute name="Value" type="xs:string" use="optional"/>
  </xs:complexType>

  <!-- <ModifyWeapon name="..." skill="...">+10</ModifyWeapon>: optional skill=, specifies
       the skill when the targeted weapon has several. -->
  <xs:complexType name="ModifyWeaponType">
    <xs:simpleContent>
      <xs:extension base="xs:string">
        <xs:attribute name="name" type="xs:string" use="required"/>
        <xs:attribute name="skill" type="xs:string" use="optional"/>
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>

  <xs:complexType name="CareerBonusType">
    <xs:sequence>
      <xs:element name="Description" type="LangString"/>
      <xs:element name="Career" type="PlainString"/>
      <!-- Empty when the bonus applies to all ethnicities: WinLivre does not write the empty tag. -->
      <xs:element name="Specie" type="PlainString" minOccurs="0"/>
      <xs:element name="Talent" type="PlainString" minOccurs="0"/>
      <xs:element name="Level" type="CareerBonusLevelType" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:attribute name="id" type="xs:string" use="required"/>
  </xs:complexType>

  <xs:complexType name="DataCareerBonusType">
      <xs:annotation>
        <xs:documentation xml:lang="en">DATA GRAFT ON A CAREER, depending on the character's membership (e.g. Empire regiments, Nations of Mankind p.6-7: "treated as if added to their career"). Conditions: Specie (the ethnicity, e.g. a province) AND Career (the Rulebook career, e.g. Soldier); when both are met, each Level adds skills/talents at the Order level of the career. In a Level, empty &lt;Skill&gt;/&lt;Talent&gt; ("") = nothing at this tier; "A/B" = a choice between two; Level id = &lt;bonus id&gt;_&lt;number&gt;. An XML comment is tolerated between two CareerBonus but not inside an entry.</xs:documentation>
      </xs:annotation>
    <xs:sequence>
      <xs:element name="CareerBonus" type="CareerBonusType" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <!-- ===== Corruption and mutation tables (shared by WFRP4 and WFRP5) ===== -->

  <!-- DATA_CORRUPTION_MENTAL / DATA_CORRUPTION_PHYSICAL: table per race, Specie[name]. -->
  <xs:complexType name="DataCorruptionMentalType">
    <xs:annotation>
      <xs:documentation xml:lang="en">MENTAL CORRUPTION PER RACE: one Specie per race, name = race code, value = d100 range that gives a MENTAL corruption (the physical one is in DATA_CORRUPTION_PHYSICAL; the two complement each other). - = never.</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="Specie" type="NamedString" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="DataCorruptionPhysicalType">
    <xs:annotation>
      <xs:documentation xml:lang="en">PHYSICAL CORRUPTION PER RACE: one Specie per race, name = race code, value = d100 range that gives a PHYSICAL corruption (the mental one is in DATA_CORRUPTION_MENTAL). - = never (elves).</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="Specie" type="NamedString" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <!-- DATA_CORRUPTION_MENTAL_CHANCE / DATA_CORRUPTION_PHYSICAL_CHANCE: Chance[name]. -->
  <xs:complexType name="DataCorruptionMentalChanceType">
    <xs:annotation>
      <xs:documentation xml:lang="en">CHANCE TABLE OF MENTAL MUTATIONS: one Chance per range, name = d100 range (01-05; the final 00 means 100), value = code of a Corruption of DATA_CORRUPTION_TABLE_MENTAL. Separate from the catalogue so that a book can renumber its ranges without changing the stored codes.</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="Chance" type="NamedString" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="DataCorruptionPhysicalChanceType">
    <xs:annotation>
      <xs:documentation xml:lang="en">CHANCE TABLE OF PHYSICAL MUTATIONS: one Chance per range, name = d100 range, value = code of a Corruption of DATA_CORRUPTION_TABLE_PHYSICAL. Separate from the catalogue (see DATA_CORRUPTION_MENTAL_CHANCE).</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="Chance" type="NamedString" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <!-- DATA_CORRUPTION_TABLE_MENTAL: Corruption[name] > Description, Explanation, ModifyCarac*. -->
  <xs:complexType name="CorruptionTableMentalEntryType">
    <xs:sequence>
      <xs:element name="Description" type="LangString"/>
      <xs:element name="Explanation" type="LangString"/>
      <xs:element name="ModifyCarac" type="NamedString" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="Page" type="PlainString" minOccurs="0"/>
    </xs:sequence>
    <xs:attribute name="name" type="xs:string" use="required"/>
  </xs:complexType>

  <xs:complexType name="DataCorruptionTableMentalType">
    <xs:annotation>
      <xs:documentation xml:lang="en">CATALOGUE OF MENTAL MUTATIONS: one Corruption per mutation, name = stable code (RULES-CORMEN_*, never a range). Optional Description, Explanation, ModifyCarac. The roll goes through DATA_CORRUPTION_MENTAL then DATA_CORRUPTION_MENTAL_CHANCE.</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="Corruption" type="CorruptionTableMentalEntryType" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <!-- DATA_CORRUPTION_TABLE_PHYSICAL: Corruption[name] > Description, Explanation, then a
       variable, repeatable mix of ModifyCarac[name]/ModifArmour[name] (often 1 per
       location, hence several)/ModifySkill[name]/ModifySkillAttribut[name]/Weapon,
       checked on BOOK_RULESBOOK.Xml (CORPHY_012, CORPHY_016: 4x ModifArmour). -->
  <xs:complexType name="CorruptionTablePhysicalEntryType">
    <xs:sequence>
      <xs:element name="Description" type="LangString"/>
      <xs:element name="Explanation" type="LangString"/>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:group ref="ModificateursEffets"/>
        <xs:element name="Weapon" type="PlainString"/>
      </xs:choice>
      <xs:element name="Page" type="PlainString" minOccurs="0"/>
    </xs:sequence>
    <xs:attribute name="name" type="xs:string" use="required"/>
  </xs:complexType>

  <xs:complexType name="DataCorruptionTablePhysicalType">
    <xs:annotation>
      <xs:documentation xml:lang="en">CATALOGUE OF PHYSICAL MUTATIONS: one Corruption per mutation, name = stable code (RULES-CORPHY_*). Description, Explanation, then a free mix of numeric effects (ModifyCarac, ModifArmour one per location, ModifySkill...) and Weapon (natural weapon). Many effects stay as text.</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="Corruption" type="CorruptionTablePhysicalEntryType" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

</xs:schema>
