<?xml version="1.0" encoding="UTF-8"?>
<!--
  SCHEMA_A_FAIRE.xsd : schema de A_FAIRE.xml (le backlog, remplace A FAIRE.txt).

  REGLES
  - Un item = une ligne de travail. Il n est JAMAIS supprime : on change son etat.
  - etat : ouvert | en_cours | clos | abandonne | tranche | gele
      ouvert     : pas commence
      en_cours   : travail actif (le point de reprise detaille reste dans CONTEXT.md)
      clos       : termine ET valide par Nono ; "cloture" (JJ/MM/AAAA) obligatoire
      abandonne  : decide de ne pas le faire ; "cloture" obligatoire
      tranche    : decision de Nono a ne plus ressortir (ex. ecarte)
      gele       : volontairement en pause (ex. le francais)
  - id : unique et stable (lettres majuscules, chiffres, tirets). Jamais reutilise.
  - Texte : ce qui RESTE a faire, une phrase ; pas d historique (il va dans Log.txt).
  - Un item passe a "clos" le jour ou Nono valide, avec une entree Log.txt contenant
    "CLOS [id]".
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified">

  <xs:simpleType name="EtatType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="ouvert"/>
      <xs:enumeration value="en_cours"/>
      <xs:enumeration value="clos"/>
      <xs:enumeration value="abandonne"/>
      <xs:enumeration value="tranche"/>
      <xs:enumeration value="gele"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="IdType">
    <xs:restriction base="xs:string">
      <xs:pattern value="[A-Z0-9]+(-[A-Z0-9]+)*"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="DateType">
    <xs:restriction base="xs:string">
      <xs:pattern value="[0-3][0-9]/[0-1][0-9]/20[0-9][0-9]"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="SectionType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="MOTEUR"/>
      <xs:enumeration value="EQUIPEMENT"/>
      <xs:enumeration value="WINLIVRE"/>
      <xs:enumeration value="CONTROLE"/>
      <xs:enumeration value="INTERFACE"/>
      <xs:enumeration value="CONCEPTION"/>
      <xs:enumeration value="LIVRES"/>
      <xs:enumeration value="FRANCAIS"/>
      <xs:enumeration value="PAGES"/>
      <xs:enumeration value="SANS_LICENCE"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:element name="AFaire">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="Item" maxOccurs="unbounded">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="Texte" type="xs:string"/>
            </xs:sequence>
            <xs:attribute name="id" type="IdType" use="required"/>
            <xs:attribute name="section" type="SectionType" use="required"/>
            <xs:attribute name="etat" type="EtatType" use="required"/>
            <xs:attribute name="cloture" type="DateType" use="optional"/>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
    <xs:unique name="IdUnique">
      <xs:selector xpath="Item"/>
      <xs:field xpath="@id"/>
    </xs:unique>
  </xs:element>

</xs:schema>
